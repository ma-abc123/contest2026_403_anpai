From 3f0bd5fc8b9e6f5cc9cea3831b8f61be868287c5 Mon Sep 17 00:00:00 2001
From: ma-abc123 <abc12302019@outlook.com>
Date: Sat, 29 Aug 2026 12:03:21 +0800
Subject: [PATCH] drivers/serial/uart_bth4: log previously silent error returns

Every failure branch of the H4 pseudo-device write path (send lock,
TX buffer overflow, bad H4 packet type) returned bare -EINVAL/-E2BIG
without any trace, which made BLE bring-up on sf32lb52 effectively
undebuggable. Failure paths only - no output in normal operation.
---
 drivers/serial/uart_bth4.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/serial/uart_bth4.c b/drivers/serial/uart_bth4.c
index ffa0a44e50e..04ebdd22886 100644
--- a/drivers/serial/uart_bth4.c
+++ b/drivers/serial/uart_bth4.c
@@ -35,6 +35,7 @@
 #include <fcntl.h>
 #include <string.h>
 #include <poll.h>
+#include <syslog.h>
 
 #include <nuttx/wireless/bluetooth/bt_hci.h>
 #include <nuttx/wireless/bluetooth/bt_uart.h>
@@ -282,9 +283,11 @@ static ssize_t uart_bth4_write(FAR struct file *filep,
   ret = nxmutex_lock(&dev->sendlock);
   if (ret < 0)
     {
+      syslog(LOG_ERR, "uart_bth4: sendlock failed: %d\n", ret);
       return ret;
     }
 
+
   if (dev->drv->head_reserve < H4_HEADER_SIZE)
     {
       reserved = H4_HEADER_SIZE;
@@ -298,6 +301,9 @@ static ssize_t uart_bth4_write(FAR struct file *filep,
 
   if (dev->sendlen + buflen > CONFIG_UART_BTH4_TXBUFSIZE - reserved)
     {
+      syslog(LOG_ERR,
+             "uart_bth4: txbuf overflow sendlen=%u buflen=%u\n",
+             (unsigned int)dev->sendlen, (unsigned int)buflen);
       ret = -E2BIG;
       goto err;
     }
@@ -328,6 +334,14 @@ static ssize_t uart_bth4_write(FAR struct file *filep,
             type = BT_ISO_OUT;
             break;
           default:
+            syslog(LOG_ERR,
+                   "uart_bth4: bad h4 type %02x sendlen=%u buflen=%u "
+                   "b0=%02x b1=%02x b2=%02x\n",
+                   *(data - H4_HEADER_SIZE),
+                   (unsigned int)dev->sendlen, (unsigned int)buflen,
+                   buffer[0],
+                   buflen > 1 ? buffer[1] : 0,
+                   buflen > 2 ? buffer[2] : 0);
             ret = -EINVAL;
             goto err;
         }
-- 
2.34.1

