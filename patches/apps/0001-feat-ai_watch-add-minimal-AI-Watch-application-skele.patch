+include $(APPDIR)/Make.defs
+
+# AI Watch built-in application info
+
+PROGNAME  = $(CONFIG_EXAMPLES_AI_WATCH_PROGNAME)
+PRIORITY  = $(CONFIG_EXAMPLES_AI_WATCH_PRIORITY)
+STACKSIZE = $(CONFIG_EXAMPLES_AI_WATCH_STACKSIZE)
+HEAPSIZE  = $(CONFIG_EXAMPLES_AI_WATCH_HEAPSIZE)
+MODULE    = $(CONFIG_EXAMPLES_AI_WATCH)
+
+# AI Watch Application
+
+MAINSRC = ai_watch_main.c
+
+include $(APPDIR)/Application.mk
