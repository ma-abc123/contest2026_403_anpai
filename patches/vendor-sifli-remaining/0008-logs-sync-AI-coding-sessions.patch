5))\n\ndef draw_settings(d):\n    d.ellipse([2,2,37,37], fill=(100,100,100,255))\n    d.ellipse([8,8,32,32], outline=(255,255,255,255), width=3)\n    for a in range(0, 360, 45):\n        r = math.radians(a)\n        d.line([(20+12*math.cos(r),20+12*math.sin(r)),\n                (20+17*math.cos(r),20+17*math.sin(r))],\n               fill=(255,255,255,255), width=4)\n    d.ellipse([15,15,25,25], fill=(100,100,100,255))\n    d.ellipse([15,15,25,25], outline=(255,255,255,255), width=1)\n\nicons = [\n    ('exercise', draw_exercise),\n    ('timer',    draw_timer),\n    ('reminder', draw_reminder),\n    ('settings', draw_settings),\n]\n\nlines = []\nlines.append('/****************************************************************************')\nlines.append(' * apps/ai_watch/ai_watch_icons.c')\nlines.append(' *')\nlines.append(' * Icon image data for AI Watch app menu.')\nlines.append(' * Generated programmatically using PIL (Python Imaging Library).')\nlines.append(' * Shapes drawn as vector graphics and exported as ARGB8888 pixel data.')\nlines.append(' *')\nlines.append(' * Licensed under the Apache License, Version 2.0.')\nlines.append(' ****************************************************************************/')\nlines.append('')\nlines.append('#include <lvgl/lvgl.h>')\nlines.append('')\n\nfor name, func in icons:\n    data = make_icon(name, func)\n    lines.append(f'static const uint8_t icon_{name}_data[] = {{')\n    row = '    '\n    for i, b in enumerate(data):\n        row += f'0x{b:02x},'\n        if (i+1) % 16 == 0:\n            lines.append(row)\n            row = '    '\n    if row.strip():\n        lines.append(row)\n    lines.append('};')\n    lines.append('')\n\n# Image descriptors for LVGL v9\nfor name, _ in icons:\n    lines.append(f'const lv_image_dsc_t icon_{name} = {{')\n    lines.append(f'  .header = {{')\n    lines.append(f'    .magic = LV_IMAGE_HEADER_MAGIC,')\n    lines.append(f'    .cf = LV_COLOR_FORMAT_ARGB8888,')\n    lines.append(f'    .flags = 0,')\n    lines.append(f'    .w = {W},')\n    lines.append(f'    .h = {H},')\n    lines.append(f'    .stride = {W * 4},')\n    lines.append(f'    .reserved_2 = 0,')\n    lines.append(f'  }},')\n    lines.append(f'  .data_size = {len(data)},')\n    lines.append(f'  .data = icon_{name}_data,')\n    lines.append(f'  .reserved = 0,')\n    lines.append(f'  .reserved_2 = 0,')\n    lines.append(f'}};')\n    lines.append('')\n\nwith open('/tmp/ai_watch_icons.c', 'w') as f:\n    f.write('\\n'.join(lines))\n\nprint(f\"Generated {len(lines)} lines\")\nPYEOF\npython3 /tmp/gen_icons_c.py", "description": "Generate icon C source file", "timeout": 30000}, "output": null}
