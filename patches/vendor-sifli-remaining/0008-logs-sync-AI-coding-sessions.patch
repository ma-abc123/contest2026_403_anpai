l_y;\n  lv_anim_t a;\n\n  if (index < 0 || index >= ctx->icon_count)\n    {\n      return;\n    }\n\n  target_scroll_x = ctx->icons[index].base_x;\n  target_scroll_y = ctx->icons[index].base_y;\n\n  ctx->snapping = true;\n\n  /* Animate scroll_x (no transform refresh here) */\n\n  lv_anim_init(&a);\n  lv_anim_set_var(&a, &ctx->scroll_x);\n  lv_anim_set_values(&a, (int32_t)ctx->scroll_x,\n                     (int32_t)target_scroll_x);\n  lv_anim_set_time(&a, AI_WATCH_MENU_SNAP_MS);\n  lv_anim_set_path_cb(&a, lv_anim_path_ease_out);\n  lv_anim_set_exec_cb(&a, ai_menu_snap_exec_x_cb);\n  lv_anim_set_user_data(&a, NULL);\n  lv_anim_start(&a);\n\n  /* Animate scroll_y (refreshes transform in exec callback) */\n\n  lv_anim_init(&a);\n  lv_anim_set_var(&a, &ctx->scroll_y);\n  lv_anim_set_values(&a, (int32_t)ctx->scroll_y,\n                     (int32_t)target_scroll_y);\n  lv_anim_set_time(&a, AI_WATCH_MENU_SNAP_MS);\n  lv_anim_set_path_cb(&a, lv_anim_path_ease_out);\n  lv_anim_set_exec_cb(&a, ai_menu_snap_exec_y_cb);\n  lv_anim_set_user_data(&a, watch);\n  lv_anim_set_ready_cb(&a, ai_menu_snap_ready_cb);\n  lv_anim_start(&a);\n\n  ai_menu_update_transform(watch);\n}", "new_string": "/****************************************************************************\n * Private Functions - Hex Menu: Snap Animation\n *\n * Uses a static watch pointer so the exec callback can call\n * ai_menu_update_transform without lv_anim_get per frame.\n ****************************************************************************/\n\nstatic FAR struct ai_watch_s *g_snap_watch;\n\nstatic void ai_menu_snap_exec_cb(void *var, int32_t value)\n{\n  FAR float *target = (FAR float *)var;\n\n  *target = (float)value;\n\n  /* Refresh once per frame (called from scroll_y animation only) */\n\n  if (g_snap_watch != NULL)\n    {\n      ai_menu_update_transform(g_snap_watch);\n    }\n}\n\nstatic void ai_menu_snap_ready_cb(lv_anim_t *a)\n{\n  if (g_snap_watch != NULL)\n    {\n      g_snap_watch->menu.snapping = false;\n      ai_menu_update_transform(g_snap_watch);\n      g_snap_watch = NULL;\n    }\n}\n\nstatic void ai_menu_start_snap(FAR struct ai_watch_s *watch, int index)\n{\n  FAR struct ai_menu_ctx_s *ctx = &watch->menu;\n  float target_scroll_x;\n  float target_scroll_y;\n  lv_anim_t a;\n\n  if (index < 0 || index >= ctx->icon_count)\n    {\n      return;\n    }\n\n  target_scroll_x = ctx->icons[index].base_x;\n  target_scroll_y = ctx->icons[index].base_y;\n\n  ctx->snapping = true;\n  g_snap_watch = watch;\n\n  /* Animate scroll_x (no transform refresh) */\n\n  lv_anim_init(&a);\n  lv_anim_set_var(&a, &ctx->scroll_x);\n  lv_anim_set_values(&a, (int32_t)ctx->scroll_x,\n                     (int32_t)target_scroll_x);\n  lv_anim_set_time(&a, AI_WATCH_MENU_SNAP_MS);\n  lv_anim_set_path_cb(&a, lv_anim_path_ease_out);\n  lv_anim_set_exec_cb(&a, ai_menu_snap_exec_cb);\n  lv_anim_start(&a);\n\n  /* Animate scroll_y (also triggers transform refresh in exec cb) */\n\n  lv_anim_init(&a);\n  lv_anim_set_var(&a, &ctx->scroll_y);\n  lv_anim_set_values(&a, (int32_t)ctx->scroll_y,\n                     (int32_t)target_scroll_y);\n  lv_anim_set_time(&a, AI_WATCH_MENU_SNAP_MS);\n  lv_anim_set_path_cb(&a, lv_anim_path_ease_out);\n  lv_anim_set_exec_cb(&a, ai_menu_snap_exec_cb);\n  lv_anim_set_ready_cb(&a, ai_menu_snap_ready_cb);\n  lv_anim_start(&a);\n\n  ai_menu_update_transform(watch);\n}"}, "output": null}
