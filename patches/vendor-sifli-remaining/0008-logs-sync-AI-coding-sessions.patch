 rt_pm_release(mode)\n331\t#endif /* BSP_USING_PM */\n332\t\n333\t#ifdef BSP_USING_DFU\n334\t#include \"bf0_ble_dfu.h\"\n335\t\n336\tstatic void dfu_btn_event_cb(lv_obj_t *obj, lv_event_t evt)\n337\t{\n338\t    if ((evt == LV_EVENT_DELETE) && (obj == mbox))\n339\t    {\n340\t        /* Delete the parent modal background */\n341\t        lv_obj_del_async(lv_obj_get_parent(mbox));\n342\t        mbox = NULL; /* happens before object is actually deleted! */\n343\t        //lv_label_set_text(info, welcome_info);\n344\t    }\n345\t    else if (evt == LV_EVENT_VALUE_CHANGED)\n346\t    {\n347\t        uint16_t btn_idx = lv_msgbox_get_active_btn(obj);\n348\t        if (0 == btn_idx)\n349\t        {\n350\t            rt_device_control(lcd_device, RTGRAPHIC_CTRL_POWEROFF, NULL);\n351\t            rt_hw_cpu_reset();\n352\t        }\n353\t        else\n354\t        {\n355\t            /* A button was clicked */\n356\t            lv_msgbox_start_auto_close(mbox, 0);\n357\t        }\n358\t    }\n359\t}\n360\t\n361\tstatic void opa_anim(void *bg, lv_anim_value_t v)\n362\t{\n363\t    lv_obj_set_style_local_bg_opa(bg, LV_OBJ_PART_MAIN, LV_STATE_DEFAULT, v);\n364\t}\n365\t\n366\t\n367\tstatic void show_dfu_reboot_msgbox(void)\n368\t{\n369\t    /* Create a base object for the modal background */\n370\t    lv_obj_t *obj = lv_obj_create(lv_scr_act(), NULL);\n371\t    _lv_obj_set_style_local_color(obj, LV_OBJ_PART_MAIN, LV_STYLE_BG_COLOR, LV_COLOR_BLACK);\n372\t    lv_obj_set_pos(obj, 0, 0);\n373\t    lv_obj_set_size(obj, LV_HOR_RES, LV_VER_RES);\n374\t\n375\t    static const char *btns2[] = {\"Ok\", \"Cancel\", \"\"};\n376\t\n377\t    /* Create the message box as a child of the modal background */\n378\t    mbox = lv_msgbox_create(obj, NULL);\n379\t    lv_msgbox_add_btns(mbox, btns2);\n380\t    lv_msgbox_set_text(mbox, \"Upgrade firmware is ready! Do you want to update?\");\n381\t    lv_obj_align(mbox, NULL, LV_ALIGN_CENTER, 0, 0);\n382\t    lv_obj_set_event_cb(mbox, dfu_btn_event_cb);\n