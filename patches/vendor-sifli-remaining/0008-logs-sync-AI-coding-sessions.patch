N\n113\t#endif\n114\t\n115\t\n116\t/**\n117\t * iterate over builtin app list\n118\t */\n119\textern const builtin_app_desc_t *gui_builtin_app_list_open(void);\n120\textern const builtin_app_desc_t *gui_builtin_app_list_get_next(const builtin_app_desc_t *ptr_app);\n121\textern void gui_builtin_app_list_close(const builtin_app_desc_t *ptr_app);\n122\t\n123\t\n124\t/**\n125\t ***********************  Dynamic load app description ************************************************\n126\t */\n127\t/**\n128\t * system registered dl-app file description\n129\t */\n130\ttypedef struct\n131\t{\n132\t    char id[GUI_APP_ID_MAX_LEN];                    //!< dl_app id,an unique character id of an app (both built-in app and dl app)\n133\t    char dir[GUI_DL_APP_MAX_FILE_PATH_LEN];         //!< dl_app store root directory\n134\t    char name[GUI_APP_NAME_MAX_LEN];                //!< dl_app display name\n135\t    char icon[GUI_DL_APP_MAX_FILE_PATH_LEN];        //!< dl_app display icon relative path, base on it's root directory\n136\t    char exe_file[GUI_DL_APP_MAX_FILE_PATH_LEN];    //!< dl_app executable file relative path, base on root directory\n137\t} dl_app_reg_desc_t;\n138\t\n139\t/**\n140\t * iterate over registed dl_app_list\n141\t */\n142\textern const char *gui_dl_app_list_open(void);\n143\textern rt_err_t gui_dl_app_list_get_next(const char **ppf_buff, dl_app_reg_desc_t *record);\n144\textern void gui_dl_app_list_close(const char *ptr_app);\n145\t\n146\t#define GUI_APP_CMD_MAX_LEN 32\n147\t\n148\ttypedef struct\n149\t{\n150\t    char name[GUI_APP_NAME_MAX_LEN];\n151\t    lv_img_dsc_t icon;\n152\t    char cmd[GUI_APP_CMD_MAX_LEN];\n153\t\n154\t    uint8_t row;   //!< TODO: remove me\n155\t    uint8_t col;  //!< TODO: remove me\n156\t\n157\t\n158\t    rt_list_t node;\n159\t} app_mainmenu_item_t;\n160\t\n161\ttypedef struct\n162\t{\n163\t    uint8_t num;\n164\t    lv_obj_t *scr;\n165\t    lv_obj_t *pg_obj;\n166\t\n167\t    uint8_t row_num;\n168\t\n169\t    lv_obj_t **list;\n170\t#ifdef DEBUG_APP_MAINMENU_DISPLAY_ICON_COORDINATE\n171\t    lv_obj_t **label_list;\n172\t    lv_obj_t *param_ctrl[4];\n173\t#endif\n174\t\n175\t    //Pivot before transformed\n176\t    lv_point_t *icon_pivot;\n177\t\n178\t    /* current screen centern icon*/\n179\t    lv_obj_t *cicon;\n180\t\n181\t    /*Focus/Zoom anim obj*/\n182\t    lv_obj_t *anim_obj;\n183\t\n184\t    /*\n185\t        RANGE(0 ~ 2)\n186\t\n187\t        = 1  no zoom\n188\t        < 1  zoom out\n189\t        > 1  zoom in\n190\t\n191\t        NOTE:\n192\t        Icons only transform while zoom belong (0, 1],\n193\t        and zoom will be applied as tranformation ratio.\n194\t    */\n195\t    float zoom;\n196\t    float last_zoom;\n197\t    lv_point_t comp_vect;\n198\t\n199\t    lv_indev_t *indev;\n200\t    bool springback_open;\n201\t\n202\t    /*\n203\t        We NOT use lv_obj scroll, so here are scroll states\n204\t    */\n205\t    bool scroll_actived;\n206\t    lv_point_t scroll_sum;\n207\t} app_mainmenu_ctx_t;\n208\t\n209\t#ifndef BSP_USING_LVGL_INPUT_AGENT\n210\t    static\n211\t#endif\n212\tapp_mainmenu_ctx_t app_mainmenu_ctx;\n213\t//static rt_list_t app_list;\n214\t\n215\tstatic void icon_event_callback(lv_event_t *e);\n216\tstatic void page_event_callback(lv_event_t *e);\n217\tstatic void get_icon_col_row(uint16_t idx, uint16_t *p_col, uint16_t *p_row);\n218\tstatic int layout_icon_transform(uint32_t row_idx, uint32_t col_idx, float *p_float_x, float *p_float_y, float *p_float_icon_w, float *p_float_icon_h, float *p_float_pivot_r);\n219\tstatic void app_mainmenu_icons_transform(bool force_refresh);\n220\t\n221\t\n222\tstatic bool limit_square(lv_area_t *parent_area, float *x, float *y, float *icon_r)\n223\t{\n224\t    float res_x1, res_x2, res_y1, res_y2;\n225\t\n226\t\n227\t    /* Get the smaller area from 'a1_p' and 'a2_p' */\n228\t    res_x1 = LV_MAX((float) parent_area->x1, *x - *icon_r);\n229\t    res_y1 = LV_MAX((float) parent_area->y1, *y - *icon_r);\n230\t    res_x2 = LV_MIN((float) parent_area->x2, *x + *icon_r);\n231\t    res_y2 = LV_MIN((float) parent_area->y2, *y + *icon_r);\n232\t\n233\t    /*If x1 or y1 greater then x2 or y2 then the areas union is empty*/\n234\t    bool union_ok = true;\n235\t    if ((res_x1 > res_x2) || (res_y1 > res_y2))\n236\t    {\n237\t        *icon_r = 0;\n238\t        union_ok = false;\n239\t    }\n240\t    else\n241\t    {\n242\t        float new_w, new_h;\n243\t\n244\t        new_w = res_x2 - res_x1 + 1;\n245\t        new_h = res_y2 - res_y1 + 1;\n246\t\n247\t        *icon_r = LV_MIN((new_w / 2), (new_h / 2));\n248\t        *x = res_x1 + (new_w / 2);\n249\t        *y = res_y1 + (new_h / 2);\n250\t    }\n251\t\n252\t    return union_ok;\n253\t}\n254\t\n255\tstatic int cal_dist(uint16_t x, uint16_t y, lv_point_t *pivot)\n256\t{\n257\t    int r;\n258\t\n259\t    r = (x - pivot->x) * (x - pivot->x) + (y - pivot->y) * (y - pivot->y);\n260\t    {\n261\t        lv_sqrt_res_t ds;\n262\t        lv_sqrt(r, &ds, 0x8000);\n263\t        r = ds.i;\n264\t    }\n265\t    return r;\n266\t}\n267\t\n268\tstatic void limit_round(uint16_t limit_r, lv_point_t *zoom_pivot, lv_coord_t *x, lv_coord_t *y, uint16_t *icon_r, uint16_t pivot_r)\n269\t{\n270\t    if (pivot_r == 0)\n271\t        pivot_r = cal_dist(*x, *y, zoom_pivot);\n272\t    if (pivot_r + *icon_r > limit_r)\n273\t    {\n274\t        if (pivot_r - *icon_r < limit_r)\n275\t        {\n276\t            int32_t new_pivot_r;\n277\t            int32_t old_w, old_h;\n278\t\n279\t            old_w = *x - zoom_pivot->x;\n280\t            old_h = *y - zoom_pivot->y;\n281\t\n282\t            *icon_r = (limit_r - (pivot_r - *icon_r)) >> 1;\n283\t            new_pivot_r = limit_r - *icon_r;\n284\t\n285\t            *x += (old_w * new_pivot_r / pivot_r) - old_w;\n286\t            *y += (old_h * new_pivot_r / pivot_r) - old_h;\n287\t\n288\t        }\n289\t        else\n290\t            *icon_r = 0;\n291\t    }\n292\t}\n293\t\n294\tstatic void limit_round2(float limit_r, lv_point_t *zoom_pivot, float *x, float *y, float *icon_r, float pivot_r)\n295\t{\n296\t    if (pivot_r + *icon_r > limit_r)\n297\t    {\n298\t        if (pivot_r - *icon_r < limit_r)\n299\t        {\n300\t            float new_pivot_r;\n301\t            float old_w, old_h;\n302\t\n303\t            old_w = *x - (float) zoom_pivot->x;\n304\t            old_h = *y - (float) zoom_pivot->y;\n305\t\n306\t            *icon_r = (limit_r - (pivot_r - *icon_r)) / 2;\n307\t            new_pivot_r = limit_r - *icon_r;\n308\t\n309\t            *x += (old_w * new_pivot_r / pivot_r) - old_w;\n310\t            *y += (old_h * new_pivot_r / pivot_r) - old_h;\n311\t\n312\t        }\n313\t        else\n314\t            *icon_r = 0;\n315\t    }\n316\t}\n317\t\n318\tstatic lv_obj_t **get_icon_obj(uint32_t row_idx, uint32_t col_idx)\n319\t{\n320\t    if ((row_idx  >= MAX_APP_ROW_NUM) || (col_idx >= MAX_APP_COL_NUM))\n321\t    {\n322\t        return NULL;\n323\t    }\n324\t\n325\t    return &(app_mainmenu_ctx.list[col_idx * MAX_APP_ROW_NUM + row_idx]);\n326\t}\n327\t\n328\t\n329\tstatic lv_point_t *get_icon_pivot(uint32_t row_idx, uint32_t col_idx)\n330\t{\n331\t    if ((row_idx  >= MAX_APP_ROW_NUM) || (col_idx >= MAX_APP_COL_NUM))\n332\t    {\n333\t        return NULL;\n334\t    }\n335\t\n336\t    return &(app_mainmenu_ctx.icon_pivot[col_idx * MAX_APP_ROW_NUM + row_idx]);\n337\t}\n338\t\n339\t\n340\t/**\n341\t * get icon colume and row by index as below(idx 0 row=(MAX_APP_ROW_NUM >> 1), col=(MAX_APP_COL_NUM >> 1)):\n342\t *\n343\t *     19___20___21___22\n344\t *      |              \\\n345\t *      |  7___8___9   23\n346\t *      |  |        \\    \\\n347\t *     18  | 1___2   10   24\n348\t *    /    |  \\   \\   \\    \\\n349\t *   17    6   0   3   11   25\n350\t *    \\     \\     /   /     /\n351\t *     16    5___4   12    26\n352\t *      \\           /      /\n353\t *       15___14___13    27\n354\t * \\n\n355\t *\n356\t * @param i\n357\t * @param p_col\n358\t * @param p_row\n359\t * \\n\n360\t * @see\n361\t */\n362\tstatic void layout_get_icon_col_row_by_idx(uint16_t idx, uint16_t *p_col, uint16_t *p_row)\n363\t{\n364\t    int16_t col, row;\n365\t    uint16_t i, total, hexagon_r;\n366\t\n367\t    uint16_t one_edge_icons, hexagon_icons;\n368\t\n369\t    if (0 != idx)\n370\t    {\n371\t        //find which hexagon is this icon on\n372\t        total = 0, hexagon_r = 0, hexagon_icons = 1;\n373\t        while (total + hexagon_icons - 1 < idx)\n374\t        {\n375\t            total += hexagon_icons;\n376\t            hexagon_r++;\n377\t            hexagon_icons = hexagon_r * 6;\n378\t        }\n379\t\n380\t        //icons on one edge of this hexagon\n381\t        one_edge_icons = hexagon_r + 1;\n382\t        //first icon's  row&col num of this hexagon\n383\t        row = 0;\n384\t        col = 0 - hexagon_r;\n385\t\n386\t        //calculate row&col from first one to idx\n387\t        for (i = 0; i < hexagon_icons; i++)\n388\t        {\n389\t            if (total + i == idx)\n390\t                break;\n391\t\n392\t            switch (i / (one_edge_icons - 1))\n393\t            {\n394\t            case 0:\n395\t                col++;\n396\t                row--;\n397\t                break;\n398\t\n399\t            case 1:\n400\t                col++;\n401\t                break;\n402\t\n403\t            case 2:\n404\t                row++;\n405\t                break;\n406\t\n407\t            case 3:\n408\t                col--;\n409\t                row++;\n410\t                break;\n411\t\n412\t            case 4:\n413\t                col--;\n414\t                break;\n415\t\n416\t            case 5:\n417\t                row--;\n418\t                break;\n419\t\n420\t            default:\n421\t                RT_ASSERT(0);\n422\t                break;\n423\t            }\n424\t\n425\t        }\n426\t    }\n427\t    else\n428\t    {\n429\t        col = 0;\n430\t        row = 0;\n431\t    }\n432\t\n433\t    //rt_kprintf(\"icon %d, \\t [%d,%d]\\n\",idx, row,col);\n434\t    *p_col = col + (MAX_APP_COL_NUM >> 1);\n435\t    *p_row = row + (MAX_APP_ROW_NUM >> 1);\n436\t}\n437\t\n438\tstatic rt_err_t get_icon_col_row_by_lv_obj(lv_obj_t *obj, uint8_t *row_idx, uint8_t *col_idx)\n439\t{\n440\t    uint8_t i, j;\n441\t\n442\t    if (NULL == obj)\n443\t    {\n444\t        return RT_EEMPTY;\n445\t    }\n446\t\n447\t    for (i = 0; i < MAX_APP_ROW_NUM; i++)\n448\t        for (j = 0; j < MAX_APP_COL_NUM; j++)\n449\t        {\n450\t            if (obj == *get_icon_obj(i, j))\n451\t            {\n452\t                *row_idx = i;\n453\t                *col_idx = j;\n454\t                return RT_EOK;\n455\t            }\n456\t        }\n457\t\n458\t    return RT_EEMPTY;\n459\t}\n460\t\n461\tstatic void printf_icon_col_row(lv_obj_t *obj)\n462\t{\n463\t    uint8_t row_idx, col_idx;\n464\t\n465\t    if (RT_EOK == get_icon_col_row_by_lv_obj(obj, &row_idx, &col_idx))\n466\t    {\n467\t        //LOG_I(\"printf_icon_col_row %x [%d,%d]\", obj, row_idx, col_idx);\n468\t    }\n469\t}\n470\t\n471\t\n472\tstatic lv_obj_t *get_nearest_icon(lv_point_t *target)\n473\t{\n474\t    lv_obj_t *ret_v = NULL;\n475\t    uint8_t row_idx, col_idx;\n476\t    uint8_t first = 1;\n477\t    float min_delta = 0, pivot_r;\n478\t\n479\t//    rt_kprintf(\"get_nearest_icon_vect  target %d, %d\\n\", target->x, target->y);\n480\t    for (row_idx = 0; row_idx < MAX_APP_ROW_NUM; row_idx++)\n481\t        for (col_idx = 0; col_idx < MAX_APP_COL_NUM; col_idx++)\n482\t        {\n483\t            uint32_t temp;\n484\t            lv_coord_t x, y;\n485\t\n486\t            lv_sqrt_res_t ds;\n487\t\n488\t            x = get_icon_pivot(row_idx, col_idx)->x;\n489\t            y = get_icon_pivot(row_idx, col_idx)->y;\n490\t\n491\t            temp = (x - target->x) * (x - target->x) + (y - target->y) * (y - target->y);\n492\t\n493\t            lv_sqrt(temp, &ds, 0x8000);\n494\t\n495\t            pivot_r = ds.i + ds.f / 256;\n496\t\n497\t            if (((pivot_r < min_delta) || first) && (NULL != *get_icon_obj(row_idx, col_idx)))\n498\t            {\n499\t                //vect2target->x =  target->x - x;\n500\t                //vect2target->y =  target->y - y;\n501\t\n502\t                ret_v = *get_icon_obj(row_idx, col_idx);\n503\t\n504\t                //rt_kprintf(\"get_nearest_icon_vect  [%d,%d] %d,%d vect %d, %d, %.1f\\n\", row_idx, col_idx, x, y, vect2target->x, vect2target->y, pivot_r);\n505\t                min_delta = pivot_r;\n506\t\n507\t                first = 0;\n508\t            }\n509\t        }\n510\t\n511\t    LV_ASSERT_NULL(ret_v);\n512\t    return  ret_v;\n513\t}\n514\t\n515\t\n516\tstatic lv_obj_t *add_app_icon(lv_obj_t *parent, const char *cmd, const void *img, uint8_t row_idx, uint8_t col_idx)\n517\t{\n518\t    lv_obj_t *icon;\n519\t    uint16_t s_len;\n520\t    char *cmd_str;\n521\t    if ((row_idx  >= MAX_APP_ROW_NUM) || (col_idx >= MAX_APP_COL_NUM))\n522\t    {\n523\t        return NULL;\n524\t    }\n525\t\n526\t    icon = lv_img_create(parent);\n527\t\n528\t    s_len = strlen(cmd) + 1;\n529\t    cmd_str = lv_mem_alloc(s_len);\n530\t    memcpy(cmd_str, cmd, s_len - 1);\n531\t    cmd_str[s_len - 1] = 0;\n532\t\n533\t    lv_obj_set_user_data(icon, (void *)cmd_str);\n534\t    lv_obj_add_flag(icon, LV_OBJ_FLAG_CLICKABLE | LV_OBJ_FLAG_EVENT_BUBBLE);\n535\t    lv_obj_clear_flag(icon, LV_OBJ_FLAG_PRESS_LOCK);\n536\t    lv_obj_add_event_cb(icon, icon_event_callback, LV_EVENT_ALL, 0);\n537\t    lv_img_set_src(icon, img); //lv_img_set_src(icon, LV_EXT_IMG_GET(img_mail)); //\n538\t    //lv_obj_set_style_img_opa(icon, LV_OPA_80, LV_PART_MAIN | LV_STATE_DEFAULT);\n539\t\n540\t    //lv_page_glue_obj(icon, true);\n541\t    //lv_obj_set_parent_event(icon, true);\n542\t    *get_icon_obj(row_idx, col_idx) = icon;\n543\t\n544\t    LV_ASSERT(lv_obj_get_self_width(icon) != 0);\n545\t    LV_ASSERT(lv_obj_get_self_height(icon) != 0);\n546\t\n547\t#ifdef DEBUG_APP_MAINMENU_DISPLAY_ICON_COORDINATE\n548\t    {\n549\t        lv_obj_t *label;\n550\t\n551\t        label = lv_label_create(parent, NULL);\n552\t        lv_ext_set_local_font(label, FONT_SMALL, LV_COLOR_WHITE);\n553\t\n554\t        *get_label_obj(row_idx, col_idx) = label;\n555\t    }\n556\t#endif\n557\t\n558\t    return icon;\n559\t}\n560\t\n561\tstatic void get_icons_init_coordinate(uint32_t row_idx, uint32_t col_idx,    lv_coord_t *x, lv_coord_t *y)\n562\t{\n563\t    /*\n564\t       r3r2r1r0    c0c1c2c3\n565\t        \\ \\ \\ \\    / / / /\n566\t         \\ \\ \\ \\  / / / /\n567\t          \\ \\ \\ \\/ / / /\n568\t           \\ \\ \\/\\/ / /\n569\t            \\ \\/\\/\\/ /\n570\t             \\/\\/\\/\\/\n571\t             /\\/\\/\\/\\\n572\t            / /\\/\\/\\ \\\n573\t           / / /\\/\\ \\ \\\n574\t          / / / /\\ \\ \\ \\\n575\t         / / / /  \\ \\ \\ \\\n576\t        / / / /    \\ \\ \\ \\\n577\t       /\n578\t      /\n579\t     /  60 degree\n580\t    /________________________\n581\t\n582\t    * (r0,c0) as (0,0) default\n583\t\n584\t    */\n585\t\n586\t\n587\t    *x = ((col_idx - row_idx) * lv_trigo_cos(60) * ICON_OUTER_RADIUS) >> (LV_TRIGO_SHIFT - 1);\n588\t    *y = ((col_idx + row_idx) * lv_trigo_sin(60) * ICON_OUTER_RADIUS) >> (LV_TRIGO_SHIFT - 1);\n589\t\n590\t    *x += C0R0_COORD_X;\n591\t    *y += C0R0_COORD_Y;\n592\t\n593\t\n594\t}\n595\t\n596\t\n597\t\n598\t\n599\tstatic int layout_icon_transform(uint32_t row_idx, uint32_t col_idx, float *p_float_x, float *p_float_y, float *p_float_icon_w, float *p_float_icon_h, float *p_float_pivot_r)\n600\t{\n601\t    float float_x = *p_float_x;\n602\t    float float_y = *p_float_y;\n603\t    float float_icon_r = (*p_float_icon_w) / 2;\n604\t    float pivot_r;      //Icon pivot to screen pivot\n605\t\n606\t    lv_point_t scr_center;\n607\t\n608\t    scr_center.x = LV_HOR_RES_MAX >> 1;\n609\t    scr_center.y = LV_VER_RES_MAX >> 1;\n610\t\n611\t    lv_area_t parent_area;\n612\t    parent_area.x1 = (LV_HOR_RES_MAX - LIMIT_RECT_WIDTH) >> 1;\n613\t    parent_area.y1 = (LV_VER_RES_MAX - LIMIT_RECT_HEIGHT) >> 1;\n614\t    parent_area.x2 = parent_area.x1 + LIMIT_RECT_WIDTH - 1;\n615\t    parent_area.y2 = parent_area.y1 + LIMIT_RECT_HEIGHT - 1;\n616\t\n617\t\n618\t    //calculate draw pivot and radius\n619\t    if (get_icon_transform_param(float_x,\n620\t                                 float_y,\n621\t                                 float_icon_r,\n622\t                                 &float_x, &float_y, &float_icon_r, &pivot_r, LV_HOR_RES_MAX, LV_VER_RES_MAX))\n623\t    {\n624\t\n625\t\n626\t#ifdef DEBUG_APP_MAINMENU_DISPLAY_ICON_PARAM\n627\t        if (LIMIT_ENABLE)\n628\t#endif /* DEBUG_APP_MAINMENU_DISPLAY_ICON_PARAM */\n629\t        {\n630\t#ifndef APP_MAINMENU_ROUND_SCREEN\n631\t            limit_round2(LIMIT_ROUND_RADIUS, &scr_center, &float_x, &float_y, &float_icon_r, pivot_r);\n632\t            limit_square(&parent_area, &float_x, &float_y, &float_icon_r);\n633\t\n634\t\n635\t#else //round screen\n636\t            limit_round2(LV_HOR_RES >> 1, &scr_center, &float_x, &float_y, &float_icon_r, pivot_r);\n637\t            //limit_round(LV_HOR_RES >> 1, &scr_center, &x, &y, &icon_r, pivot_r);\n638\t#endif\n639\t        }\n640\t\n641\t\n642\t    }\n643\t    else\n644\t    {\n645\t        float_icon_r = 0;\n646\t        float_x = 0;\n647\t        float_y = 0;\n648\t\n649\t    }\n650\t\n651\t#if 1 //Gap\n652\t\n653\t    if (float_icon_r >= (ICON_OUTER_RADIUS - ICON_INNER_RADIUS))\n654\t    {\n655\t        float_icon_r = float_icon_r - (ICON_OUTER_RADIUS - ICON_INNER_RADIUS);\n656\t    }\n657\t    else\n658\t    {\n659\t        float_icon_r = 0;\n660\t    }\n661\t#endif /* 0 */\n662\t\n663\t\n664\t\n665\t    *p_float_x = float_x ;\n666\t    *p_float_y = float_y ;\n667\t    *p_float_icon_w = float_icon_r * 2;\n668\t    *p_float_pivot_r = pivot_r;      //Icon pivot to screen pivot\n669\t\n670\t\n671\t    return (0 == float_icon_r) ? 0 : 1;\n672\t}\n673\t\n674\t\n675\t\n676\t\n677\t\n678\t#ifdef DEBUG_APP_MAINMENU_DISPLAY_ICON_COORDINATE\n679\tstatic void app_mainmenu_draw_icon_label(uint8_t row_idx, uint8_t col_idx, lv_coord_t pi_x, lv_coord_t pi_y, uint16_t r)\n680\t{\n681\t    lv_obj_t *label, *icon;\n682\t    char buff[50];\n683\t\n684\t    label = app_mainmenu_ctx.label_list[row_idx][col_idx];\n685\t    icon = app_mainmenu_ctx.list[row_idx][col_idx];\n686\t\n687\t    rt_sprintf(buff, \"%d,%d,%d\\n%d,%d,%d\", lv_obj_get_x(icon), lv_obj_get_y(icon), lv_img_get_zoom(icon),\n688\t               pi_x, pi_y, r);\n689\t    lv_label_set_text(label, buff);\n690\t    lv_obj_align(label, icon, LV_ALIGN_CENTER, 0, 0);\n691\t}\n692\t#endif\n693\t\n694\tstatic int32_t app_mainmenu_draw_icon(lv_obj_t *obj, float pi_x, float pi_y, float w, float h)\n695\t{\n696\t    uint16_t zoom;\n697\t\n698\t    if ((w != 0) && (h != 0))\n699\t    {\n700\t        lv_coord_t img_w = lv_obj_get_self_width(obj);\n701\t        lv_coord_t img_h = lv_obj_get_self_height(obj);\n702\t\n703\t        //lv_obj_clear_flag(obj, LV_OBJ_FLAG_HIDDEN);\n704\t        obj->flags &= (~LV_OBJ_FLAG_HIDDEN);\n705\t\n706\t\n707\t        //Updata zoom\n708\t        zoom = (uint16_t)(w * 256 / (float)img_w);\n709\t        //lv_img_set_zoom(obj, zoom);\n710\t#ifndef DISABLE_LVGL_V8\n711\t        ((lv_img_t *)obj)->zoom = zoom;\n712\t#else\n713\t        ((lv_img_t *)obj)->scale_x = zoom;\n714\t        ((lv_img_t *)obj)->scale_y = zoom;\n715\t#endif\n716\t\n717\t        //Move icon\n718\t        {\n719\t            int32_t pi_x_10p8 = pi_x * 256;\n720\t            int32_t pi_y_10p8 = pi_y * 256;\n721\t\n722\t            //rt_kprintf(\"app_mainmenu_draw_icon %p:  [%.3f,%.3f]->[%d, %d]   %d\\n\", obj, pi_x, pi_y, pi_x_10p8, pi_y_10p8, zoom);\n723\t\n724\t            pi_x_10p8 -= ((img_w >> 1) << 8);\n725\t            pi_y_10p8 -= ((img_h >> 1) << 8);\n726\t            //lv_obj_set_pos(obj, ((lv_coord_t)(pi_x_10p8 >> 8)) + lv_obj_get_scroll_x(app_mainmenu_ctx.pg_obj),\n727\t            //               ((lv_coord_t)(pi_y_10p8 >> 8)) + lv_obj_get_scroll_y(app_mainmenu_ctx.pg_obj));\n728\t\n729\t\n730\t            lv_obj_move_to(obj, ((lv_coord_t)(pi_x_10p8 >> 8)) + lv_obj_get_scroll_x(app_mainmenu_ctx.pg_obj),\n731\t                           ((lv_coord_t)(pi_y_10p8 >> 8)) + lv_obj_get_scroll_y(app_mainmenu_ctx.pg_obj));\n732\t\n733\t#ifndef DISABLE_LVGL_V8\n734\t            lv_img_set_x_frac(obj, (uint16_t)((pi_x_10p8 << 8)) & 0xFFFF);\n735\t            lv_img_set_y_frac(obj, (uint16_t)((pi_y_10p8 << 8)) & 0xFFFF);\n736\t#endif\n737\t        }\n738\t        //srt_kprintf(\"app_mainmenu_draw_icon %p:  %d,%d   %d\\n\",obj, pi_x, pi_y, zoom);\n739\t    }\n740\t    else\n741\t    {\n742\t        //lv_obj_add_flag(obj, LV_OBJ_FLAG_HIDDEN);\n743\t        obj->flags |= LV_OBJ_FLAG_HIDDEN;\n744\t        zoom = 0;\n745\t    }\n746\t    return zoom;\n747\t}\n748\t\n749\tstatic void app_mainmenu_init_icons_coordinate(void)\n750\t{\n751\t    lv_coord_t x, y;\n752\t    uint8_t row_idx, col_idx;\n753\t\n754\t    for (row_idx = 0; row_idx < MAX_APP_ROW_NUM; row_idx++)\n755\t        for (col_idx = 0; col_idx < MAX_APP_COL_NUM; col_idx++)\n756\t        {\n757\t            lv_obj_t *icon;\n758\t            get_icons_init_coordinate(row_idx, col_idx, &x, &y);\n759\t\n760\t            get_icon_pivot(row_idx, col_idx)->x = x;\n761\t            get_icon_pivot(row_idx, col_idx)->y = y;\n762\t\n763\t            icon = *get_icon_obj(row_idx, col_idx);\n764\t            if (icon)\n765\t            {\n766\t                lv_coord_t img_w = lv_obj_get_self_width(icon);\n767\t                lv_coord_t img_h = lv_obj_get_self_height(icon);\n768\t                uint16_t zoom = (uint16_t)(ICON_IMG_WIDTH * 256 / img_w);\n769\t\n770\t                //rt_kprintf(\"init icon [%d,%d]  %d\\n\", x, y, zoom);\n771\t\n772\t                lv_obj_set_pos(icon, x - (img_w >> 1), y - (img_h >> 1));\n773\t                lv_img_set_pivot(icon, (img_w >> 1), (img_h >> 1));\n774\t                lv_img_set_zoom(icon, zoom);\n775\t\n776\t            }\n777\t        }\n778\t\n779\t}\n780\t\n781\t\n782\t\n783\t#if 0\n784\t\n785\tstatic void app_mainmenu_click_icon_anim_ready_callback(lv_anim_t *a)\n786\t{\n787\t    if (app_mainmenu_ctx.anim_obj)\n788\t    {\n789\t        char *cmd = (char *)lv_obj_get_user_data(app_mainmenu_ctx.anim_obj);\n790\t\n791\t        if (cmd)\n792\t        {\n793\t            rt_kprintf(\"app mainmenu icon click anim cbk\\n\");\n794\t            gui_app_run(cmd);\n795\t        }\n796\t        app_mainmenu_ctx.anim_obj = NULL;\n797\t    }\n798\t}\n799\t\n800\t\n801\tstatic void app_mainmenu_focus_icon(lv_obj_t *obj, uint32_t max_anim_ms, lv_anim_ready_cb_t cbk)\n802\t{\n803\t    //lv_coord_t c0r0_x, c0r0_y;\n804\t    lv_coord_t sx, sy, dx, dy;\n805\t    lv_obj_t *pg_scrl;\n806\t    uint8_t row_idx, col_idx;\n807\t    lv_area_t parent_area;\n808\t\n809\t\n810\t    LOG_I(\"app_mainmenu_focus_icon\");\n811\t    if (RT_EOK != get_icon_col_row_by_lv_obj(obj, &row_idx, &col_idx))\n812\t        return;\n813\t\n814\t    LOG_I(\"app_mainmenu_focus_icon: row %d, col %d\", row_idx, col_idx);\n815\t\n816\t    parent_area.x1 = 0;\n817\t    parent_area.y1 = 0;\n818\t    parent_area.x2 = parent_area.x1 + LV_HOR_RES - 1;\n819\t    parent_area.y2 = parent_area.y1 + LV_VER_RES - 1;\n820\t\n821\t    pg_scrl = lv_page_get_scrl(app_mainmenu_ctx.pg_obj);\n822\t    sx = lv_obj_get_x(pg_scrl);\n823\t    sy = lv_obj_get_y(pg_scrl);\n824\t\n825\t\n826\t    dx = sx + ((parent_area.x2 + 1 - parent_area.x1) >> 1) - get_icon_pivot(row_idx, col_idx)->x;\n827\t    dy = sy + ((parent_area.y2 + 1 - parent_area.y1) >> 1) - get_icon_pivot(row_idx, col_idx)->y;\n828\t\n829\t    /*\n830\t        rt_kprintf(\"pg_scrl=[%d,%d]\\n icon=[%d,%d]\\n ciotsc=[%d,%d]\\n\", lv_obj_get_x(pg_scrl),lv_obj_get_y(pg_scrl),\n831\t                                        get_icon_pivot(row_idx,col_idx)->x,\n832\t                                        get_icon_pivot(row_idx,col_idx)->y,\n833\t                                        app_mainmenu_ctx.ciotsc.x,\n834\t                                        app_mainmenu_ctx.ciotsc.y\n835\t\n836\t                                        );\n837\t    */\n838\t\n839\t    app_mainmenu_ctx.anim_obj = NULL;\n840\t\n841\t    lv_anim_del(pg_scrl, NULL);\n842\t\n843\t    if (max_anim_ms)\n844\t    {\n845\t        lv_anim_t ax;\n846\t        lv_anim_path_t path;\n847\t        uint16_t anim_duration;\n848\t        lv_sqrt_res_t ds;\n849\t        uint32_t abs_x, abs_y;\n850\t\n851\t        if (app_mainmenu_ctx.indev)\n852\t        {\n853\t            app_mainmenu_ctx.indev->proc.types.pointer.drag_throw_vect.x = 0;\n854\t            app_mainmenu_ctx.indev->proc.types.pointer.drag_throw_vect.y = 0;\n855\t        }\n856\t        abs_x = (dx > sx) ? (dx - sx) : (sx - dx);\n857\t        abs_y = (dy > sy) ? (dy - sy) : (sy - dy);\n858\t\n859\t        _lv_sqrt(abs_x * abs_x + abs_y * abs_y, &ds, 0x8000);\n860\t\n861\t        /*\n862\t             Start animation except central icon\n863\t        */\n864\t        {\n865\t            anim_duration = max_anim_ms * ds.i / LV_HOR_RES_MAX ;\n866\t            anim_duration = LV_MIN(anim_duration, max_anim_ms);\n867\t\n868\t            //rt_kprintf(\"app_mainmenu_focus_icon anim_duration %d ms\\n\", anim_duration);\n869\t\n870\t            lv_anim_init(&ax);\n871\t            lv_anim_set_time(&ax, anim_duration);\n872\t            lv_anim_path_init(&path);\n873\t            lv_anim_set_path(&ax, &path);\n874\t            lv_anim_path_set_cb(&path, lv_anim_path_ease_in_out);\n875\t\n876\t            lv_anim_set_var(&ax, pg_scrl);\n877\t            lv_anim_set_exec_cb(&ax, (lv_anim_exec_xcb_t) lv_obj_set_x);\n878\t            lv_anim_set_values(&ax, sx, dx);\n879\t            lv_anim_start(&ax);\n880\t\n881\t            lv_anim_set_exec_cb(&ax, (lv_anim_exec_xcb_t) lv_obj_set_y);\n882\t            lv_anim_set_values(&ax, sy, dy);\n883\t            lv_anim_set_ready_cb(&ax, cbk);\n884\t            lv_anim_start(&ax);\n885\t            app_mainmenu_ctx.anim_obj = obj;\n886\t\n887\t            return;\n888\t        }\n889\t    }\n890\t    lv_obj_set_pos(pg_scrl, dx, dy);\n891\t\n892\t    if (cbk)\n893\t    {\n894\t        lv_anim_t ax;\n895\t        ax.var = obj;\n896\t        cbk(&ax);\n897\t    }\n898\t\n899\t\n900\t}\n901\t#endif\n902\t\n903\tstatic void icon_event_callback(lv_event_t *e)\n904\t{\n905\t    lv_obj_t *obj = lv_event_get_target(e);\n906\t    lv_event_code_t event = lv_event_get_code(e);\n907\t\n908\t    //rt_kprintf(\"icon_event_callback %s\\n\",lv_event_to_name(event));\n909\t    if (app_mainmenu_ctx.scroll_actived && (LV_EVENT_RELEASED == event \\\n910\t                                            || LV_EVENT_PRESS_LOST == event))\n911\t    {\n912\t        //Not to clear scroll_actived before icon receieve click event\n913\t        lv_event_stop_bubbling(e);\n914\t    }\n915\t    else if ((LV_EVENT_SHORT_CLICKED == event) && (!app_mainmenu_ctx.scroll_actived))\n916\t    {\n917\t        rt_kprintf(\"app mainmenu icon clickd\\n\");\n918\t\n919\t        lv_obj_add_flag(app_mainmenu_ctx.pg_obj, LV_OBJ_FLAG_SCROLLABLE);\n920\t        lv_obj_scroll_to_view(obj, LV_ANIM_ON);\n921\t        app_mainmenu_ctx.anim_obj = obj;\n922\t\n923\t        //There is no scroll animation if the clicked icon was just at center of pg_obj\n924\t        if (NULL == lv_anim_get(app_mainmenu_ctx.pg_obj, NULL))\n925\t        {\n926\t            //Send SCROLL_END msg manually\n927\t#ifndef  DISABLE_LVGL_V8\n928\t            lv_event_send(app_mainmenu_ctx.pg_obj, LV_EVENT_SCROLL_END, NULL);\n929\t#else\n930\t            lv_obj_send_event(app_mainmenu_ctx.pg_obj, LV_EVENT_SCROLL_END, NULL);\n931\t#endif\n932\t        }\n933\t\n934\t    }\n935\t    else if (LV_EVENT_DELETE == event)\n936\t    {\n937\t        char *cmd = (char *)lv_obj_get_user_data(obj);\n938\t        if (cmd)\n939\t            lv_mem_free(cmd);\n940\t    }\n941\t}\n942\t\n943\t\n944\t\n945\tstatic lv_obj_t *predict_focus_icon(void)\n946\t{\n947\t    lv_point_t scr_center;\n948\t    lv_point_t vect;\n949\t    uint8_t scroll_throw;\n950\t    uint32_t anim_duration;\n951\t\n952\t    lv_indev_t *indev = lv_indev_get_act();\n953\t\n954\t    scr_center.x = LV_HOR_RES_MAX >> 1;\n955\t    scr_center.y = LV_VER_RES_MAX >> 1;\n956\t\n957\t\n958\t    lv_indev_get_vect(indev, &vect);\n959\t\n960\t    LOG_I(\"scroll_throw %d,%d\", vect.x, vect.y);\n961\t#ifndef DISABLE_LVGL_V8\n962\t    scroll_throw = indev->driver->scroll_throw;\n963\t#else\n964\t    scroll_throw = 0;\n965\t#endif\n966\t    anim_duration = 0;\n967\t\n968\t    while (vect.x != 0  || vect.y != 0)\n969\t    {\n970\t        /*Reduce the vectors*/\n971\t        vect.x = vect.x * (100 - scroll_throw) / 100;\n972\t        vect.y = vect.y * (100 - scroll_throw) / 100;\n973\t\n974\t        scr_center.x = scr_center.x - vect.x;\n975\t        scr_center.y = scr_center.y - vect.y;\n976\t\n977\t        anim_duration += LV_INDEV_DEF_READ_PERIOD * 4;\n978\t    }\n979\t\n980\t    /*\n981\t       Get the compensation vector of nearest icon to new screen center\n982\t    */\n983\t    //update_icon_pivot();\n984\t    //get_nearest_icon_vect(&scr_center, &app_mainmenu_ctx.comp_vect);\n985\t\n986\t    return    get_nearest_icon(&scr_center);\n987\t}\n988\t\n989\t\n990\tstatic void page_event_callback(lv_event_t *e)\n991\t{\n992\t\n993\t    lv_obj_t *obj = lv_event_get_target(e);\n994\t    lv_event_code_t event = lv_event_get_code(e);\n995\t\n996\t\n997\t    //LOG_I(\"page_event_callback:event %s\", lv_event_to_name(event));\n998\t    if (LV_EVENT_PRESSED == event)\n999\t    {\n1000\t        //Clear anim obj in case stop scroll to been aborted\n1001\t        app_mainmenu_ctx.anim_obj = NULL;\n1002\t        lv_obj_clear_flag(app_mainmenu_ctx.pg_obj, LV_OBJ_FLAG_SCROLLABLE);\n1003\t\n1004\t        if (0 != lv_anim_count_running())\n1005\t        {\n1006\t            lv_anim_del(app_mainmenu_ctx.pg_obj, NULL);\n1007\t            //lv_anim_del(lv_page_get_scrl(app_mainmenu_ctx.pg_obj), NULL);\n1008\t        }\n1009\t        app_mainmenu_ctx.springback_open = false;\n1010\t    }\n1011\t    else if (LV_EVENT_RELEASED == event \\\n1012\t             || LV_EVENT_PRESS_LOST == event || LV_EVENT_CLICKED == event)\n1013\t    {\n1014\t        lv_obj_add_flag(app_mainmenu_ctx.pg_obj, LV_OBJ_FLAG_SCROLLABLE);\n1015\t\n1016\t        if (app_mainmenu_ctx.scroll_actived)\n1017\t        {\n1018\t            app_mainmenu_ctx.springback_open = true;\n1019\t\n1020\t            LOG_I(\"predict focus icon:\");\n1021\t            printf_icon_col_row(predict_focus_icon());\n1022\t\n1023\t            lv_obj_scroll_to_view(predict_focus_icon(), LV_ANIM_ON);\n1024\t        }\n1025\t\n1026\t        app_mainmenu_ctx.scroll_actived = false;\n1027\t        app_mainmenu_ctx.scroll_sum.x = 0;\n1028\t        app_mainmenu_ctx.scroll_sum.y = 0;\n1029\t\n1030\t    }\n1031\t    else if (LV_EVENT_PRESSING == event)\n1032\t    {\n1033\t        lv_indev_t *indev = lv_indev_get_act();\n1034\t        lv_point_t p;\n1035\t\n1036\t        lv_indev_get_vect(indev, &p);\n1037\t\n1038\t        app_mainmenu_ctx.scroll_sum.x += p.x;\n1039\t        app_mainmenu_ctx.scroll_sum.y += p.y;\n1040\t\n1041\t#ifndef DISABLE_LVGL_V8\n1042\t        if ((LV_ABS(app_mainmenu_ctx.scroll_sum.x) > indev->driver->scroll_limit)\n1043\t                || (LV_ABS(app_mainmenu_ctx.scroll_sum.y) > indev->driver->scroll_limit)\n1044\t                || app_mainmenu_ctx.scroll_actived)\n1045\t        {\n1046\t            app_mainmenu_ctx.scroll_actived = true;\n1047\t            //_lv_obj_scroll_by_raw(app_mainmenu_ctx.pg_obj, p.x, p.y); scroll once before draw to speed up\n1048\t            lv_obj_invalidate(app_mainmenu_ctx.pg_obj);\n1049\t        }\n1050\t#endif\n1051\t\n1052\t#ifdef DISABLE_LVGL_V8\n1053\t\n1054\t\n1055\t\n1056\t        if (app_mainmenu_ctx.scroll_actived)\n1057\t        {\n1058\t            _lv_obj_scroll_by_raw(app_mainmenu_ctx.pg_obj,\n1059\t                                  app_mainmenu_ctx.scroll_sum.x,\n1060\t                                  app_mainmenu_ctx.scroll_sum.y);\n1061\t\n1062\t            app_mainmenu_ctx.scroll_sum.x = 0;\n1063\t            app_mainmenu_ctx.scroll_sum.y = 0;\n1064\t        }\n1065\t        app_mainmenu_icons_transform(false);\n1066\t        printf_icon_col_row(app_mainmenu_ctx.cicon);\n1067\t#endif /* DISABLE_LVGL_V8 */\n1068\t\n1069\t    }\n1070\t#ifndef DISABLE_LVGL_V8\n1071\t    else if (LV_EVENT_DRAW_MAIN_BEGIN == event)\n1072\t    {\n1073\t\n1074\t\n1075\t        if (app_mainmenu_ctx.scroll_actived)\n1076\t        {\n1077\t            _lv_obj_scroll_by_raw(app_mainmenu_ctx.pg_obj,\n1078\t                                  app_mainmenu_ctx.scroll_sum.x,\n1079\t                                  app_mainmenu_ctx.scroll_sum.y);\n1080\t\n1081\t            app_mainmenu_ctx.scroll_sum.x = 0;\n1082\t            app_mainmenu_ctx.scroll_sum.y = 0;\n1083\t        }\n1084\t        app_mainmenu_icons_transform(false);\n1085\t        printf_icon_col_row(app_mainmenu_ctx.cicon);\n1086\t    }\n1087\t#endif /* DISABLE_LVGL_V8 */\n1088\t    else if (LV_EVENT_SCROLL_END == event)\n1089\t    {\n1090\t        if (app_mainmenu_ctx.anim_obj)\n1091\t        {\n1092\t            char *cmd = (char *)lv_obj_get_user_data(app_mainmenu_ctx.anim_obj);\n1093\t\n1094\t            if (cmd)\n1095\t            {\n1096\t                rt_kprintf(\"app mainmenu icon click anim cbk\\n\");\n1097\t                gui_app_run(cmd);\n1098\t            }\n1099\t            app_mainmenu_ctx.anim_obj = NULL;\n1100\t        }\n1101\t    }\n1102\t\n1103\t\n1104\t}\n1105\t\n1106\t\n1107\tstatic inline int16_t reorder_clock_icon(int16_t idx, int16_t clock_idx, const builtin_app_desc_t *builtin_app, lv_obj_t *page)\n1108\t{\n1109\t    uint16_t col, row;\n1110\t\n1111\t    //Fix 1st icon for clock\n1112\t    if (0 == strcmp(\"clock\", builtin_app->id))\n1113\t    {\n1114\t        lv_obj_t *icon;\n1115\t        layout_get_icon_col_row_by_idx(clock_idx, &col, &row);\n1116\t\n1117\t        icon = add_app_icon(page, \"clock\", builtin_app->icon, row, col);\n1118\t\n1119\t        if (icon)        lv_obj_move_to_index(icon, 0);\n1120\t    }\n1121\t    else if (0 == strcmp(APP_ID, builtin_app->id)) //skip main menu icon\n1122\t    {\n1123\t\n1124\t    }\n1125\t    else if (NULL != builtin_app->icon)\n1126\t    {\n1127\t        if (idx == clock_idx)\n1128\t            idx++;\n1129\t\n1130\t        layout_get_icon_col_row_by_idx(idx, &col, &row);\n1131\t        add_app_icon(page, builtin_app->id, builtin_app->icon, row, col);\n1132\t        idx++;\n1133\t    }\n1134\t\n1135\t    return idx;\n1136\t}\n1137\t\n1138\t\n1139\t\n1140\tstatic void app_mainmenu_read_app_icons(lv_obj_t *page)\n1141\t{\n1142\t    uint16_t col, row;\n1143\t    uint16_t idx = 0, clock_idx;\n1144\t    const builtin_app_desc_t *p_builtin_app;\n1145\t    int mainmenu_icon_style;\n1146\t\n1147\t    clock_idx = 0; /* 0 - reserved for clock app*/\n1148\t    mainmenu_icon_style = 0x00;\n1149\t\n1150\t\n1151\t    /*1. load builtin app list*/\n1152\t    p_builtin_app = gui_builtin_app_list_open();\n1153\t    if (p_builtin_app)\n1154\t    {\n1155\t        do\n1156\t        {\n1157\t            //Fix 1st icon for clock\n1158\t            idx = reorder_clock_icon(idx, clock_idx, p_builtin_app, page);\n1159\t            p_builtin_app = gui_builtin_app_list_get_next(p_builtin_app);\n1160\t        }\n1161\t        while (p_builtin_app);\n1162\t\n1163\t        while (1)\n1164\t        {\n1165\t            //Fix 1st icon for clock\n1166\t            p_builtin_app = gui_script_app_list_get_next(p_builtin_app, SCRIPT_TYPE_MPY);\n1167\t            if (p_builtin_app == NULL)\n1168\t                break;\n1169\t            idx = reorder_clock_icon(idx, clock_idx, p_builtin_app, page);\n1170\t        }\n1171\t\n1172\t        gui_builtin_app_list_close(p_builtin_app);\n1173\t        p_builtin_app = NULL;\n1174\t    }\n1175\t\n1176\t#if 1//for demo, full fill screen\n1177\t    {\n1178\t 