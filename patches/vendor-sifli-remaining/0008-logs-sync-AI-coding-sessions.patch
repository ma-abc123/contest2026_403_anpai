       \"AI Watch v\" AI_WATCH_VERSION \"\\n\"\n969\t                    \"Board: SF32LB52\\n\"\n970\t                    \"Touch: Checking...\\n\"\n971\t                    \"RTC: Checking...\");\n972\t  lv_obj_set_style_text_color(watch->about_label,\n973\t                              ai_watch_theme_secondary(theme), 0);\n974\t  lv_obj_set_style_text_font(watch->about_label, &lv_font_montserrat_14, 0);\n975\t  lv_obj_align(watch->about_label, LV_ALIGN_CENTER, 0, 50);\n976\t\n977\t  /* Back hint */\n978\t\n979\t  hint = lv_label_create(screen);\n980\t  lv_label_set_text(hint, LV_SYMBOL_LEFT \" Back (KEY2)\");\n981\t  lv_obj_set_style_text_color(hint, ai_watch_theme_secondary(theme), 0);\n982\t  lv_obj_set_style_text_font(hint, &lv_font_montserrat_16, 0);\n983\t  lv_obj_align(hint, LV_ALIGN_BOTTOM_MID, 0, -20);\n984\t}\n985\t\n986\t/****************************************************************************\n987\t * Private Functions - Home Page (Digital Watchface)\n988\t ****************************************************************************/\n989\t\n990\tstatic void ai_watch_create_home_page(FAR struct ai_watch_s *watch)\n991\t{\n992\t  FAR lv_obj_t *screen = lv_obj_create(NULL);\n993\t  FAR lv_obj_t *title;\n994\t  FAR lv_obj_t *hint;\n995\t  int theme = watch->current_theme;\n996\t\n997\t  lv_obj_set_style_bg_color(screen, ai_watch_theme_bg(theme), 0);\n998\t  watch->home_screen = screen;\n999\t  watch->fixed_pages[AI_WATCH_PAGE_HOME] = screen;\n1000\t\n1001\t  /* Title */\n1002\t\n1003\t  title = lv_label_create(screen);\n1004\t  lv_label_set_text(title, \"AI Watch\");\n1005\t  lv_obj_set_style_text_color(title, ai_watch_theme_text(theme), 0);\n1006\t  lv_obj_set_style_text_font(title, &lv_font_montserrat_20, 0);\n1007\t  lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 40);\n1008\t\n1009\t  /* Large time display HH:MM */\n1010\t\n1011\t  watch->time_label = lv_label_create(screen);\n1012\t  lv_label_set_text(watch->time_label, \"--:--\");\n1013\t  lv_obj_set_style_text_color(watch->time_label,\n1014\t                              ai_watch_theme_text(theme), 0);\n1015\t  lv_obj_set_style_text_font(watch->time_label, &lv_font_montserrat_48, 0);\n1016\t  lv_obj_align(watch->time_label, LV_ALIGN_CENTER, 0, -40);\n1017\t\n1018\t  /* Seconds display */\n1019\t\n1020\t  watch->seconds_label = lv_label_create(screen);\n1021\t  lv_label_set_text(watch->seconds_label, \":--\");\n1022\t  lv_obj_set_style_text_color(watch->seconds_label,\n1023\t                              ai_watch_theme_secondary(theme), 0);\n1024\t  lv_obj_set_style_text_font(watch->seconds_label, &lv_font_montserrat_24, 0);\n1025\t  lv_obj_align_to(watch->seconds_label, watch->time_label,\n1026\t                  LV_ALIGN_OUT_RIGHT_MID, 5, 8);\n1027\t\n1028\t  /* Date display */\n1029\t\n1030\t  watch->date_label = lv_label_create(screen);\n1031\t  lv_label_set_text(watch->date_label, \"----/--/--\");\n1032\t  lv_obj_set_style_text_color(watch->date_label,\n1033\t                              ai_watch_theme_secondary(theme), 0);\n1034\t  lv_obj_set_style_text_font(watch->date_label, &lv_font_montserrat_16, 0);\n1035\t  lv_obj_align_to(watch->date_label, watch->time_label,\n1036\t                  LV_ALIGN_OUT_BOTTOM_MID, -20, 12);\n1037\t\n1038\t  /* Day of week display */\n1039\t\n1040\t  watch->dow_label = lv_label_create(screen);\n1041\t  lv_label_set_text(watch->dow_label, \"\");\n1042\t  lv_obj_set_style_text_color(watch->dow_label,\n1043\t                              ai_watch_theme_secondary(theme), 0);\n1044\t  lv_obj_set_style_text_font(watch->dow_label, &lv_font_montserrat_16, 0);\n1045\t  lv_obj_align_to(watch->dow_label, watch->date_label,\n1046\t                  LV_ALIGN_OUT_RIGHT_MID, 10, 0);\n1047\t\n1048\t  /* Bluetooth status */\n1049\t\n1050\t  watch->bt_label = lv_label_create(screen);\n1051\t  lv_label_set_text(watch->bt_label, \"BT: OFF\");\n1052\t  lv_obj_set_style_text_color(watch->bt_label,\n1053\t                              ai_watch_theme_accent(theme), 0);\n1054\t  lv_obj_set_style_text_font(watch->bt_label, &lv_font_montserrat_20, 0);\n1055\t  lv_obj_align(watch->bt_label, LV_ALIGN_BOTTOM_MID, 0, -60);\n1056\t\n1057\t  /* Navigation hint */\n1058\t\n1059\t  hint = lv_label_create(screen);\n1060\t  lv_label_set_text(hint, \"Tap or swipe up for apps\");\n1061\t  lv_obj_set_style_text_color(hint, ai_watch_theme_secondary(theme), 0);\n1062\t  lv_obj_set_style_text_font(hint, &lv_font_montserrat_16, 0);\n1063\t  lv_obj_align(hint, LV_ALIGN_BOTTOM_MID, 0, -20);\n1064\t\n1065\t  /* Click handler for tap-to-open-menu */\n1066\t\n1067\t  lv_obj_add_event_cb(screen, ai_watch_home_click_cb,\n1068\t                      LV_EVENT_CLICKED, watch);\n1069\t}\n1070\t\n1071\t/****************************************************************************\n1072\t * Private Functions - App List Page (Honeycomb Menu)\n1073\t ****************************************************************************/\n1074\t\n1075\tstatic void ai_watch_create_app_list_page(FAR struct ai_watch_s *watch)\n1076\t{\n1077\t  FAR lv_obj_t *screen = lv_obj_create(NULL);\n1078\t  FAR lv_obj_t *title;\n1079\t  FAR lv_obj_t *hint;\n1080\t  FAR lv_obj_t *container;\n1081\t  int theme = watch->current_theme;\n1082\t  int center_x = AI_WATCH_SCREEN_WIDTH / 2;\n1083\t  int start_y = 60;\n1084\t  int app_count = (int)AI_WATCH_APP_COUNT;\n1085\t  int row;\n1086\t  int col;\n1087\t  int idx;\n1088\t  int row_width;\n1089\t  int icon_x;\n1090\t  int icon_y;\n1091\t  int total_height;\n1092\t\n1093\t  lv_obj_set_style_bg_color(screen, ai_watch_theme_bg(theme), 0);\n1094\t  lv_obj_set_scrollbar_mode(screen, LV_SCROLLBAR_MODE_OFF);\n1095\t  watch->app_list_screen = screen;\n1096\t  watch->fixed_pages[AI_WATCH_PAGE_APP_LIST] = screen;\n1097\t\n1098\t  /* Title */\n1099\t\n1100\t  title = lv_label_create(screen);\n1101\t  lv_label_set_text(title, \"Apps\");\n1102\t  lv_obj_set_style_text_color(title, ai_watch_theme_text(theme), 0);\n1103\t  lv_obj_set_style_text_font(title, &lv_font_montserrat_24, 0);\n1104\t  lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 20);\n1105\t\n1106\t  /* Scrollable container for honeycomb icons */\n1107\t\n1108\t  container = lv_obj_create(screen);\n1109\t  lv_obj_set_size(container, AI_WATCH_SCREEN_WIDTH,\n1110\t                  AI_WATCH_SCREEN_HEIGHT - 40);\n1111\t  lv_obj_align(container, LV_ALIGN_TOP_MID, 0, 40);\n1112\t  lv_obj_set_style_bg_color(container, ai_watch_theme_bg(theme), 0);\n1113\t  lv_obj_set_style_border_width(container, 0, 0);\n1114\t  lv_obj_set_style_pad_all(container, 0, 0);\n1115\t  lv_obj_set_scrollbar_mode(container, LV_SCROLLBAR_MODE_OFF);\n1116\t  lv_obj_set_scroll_dir(container, LV_DIR_VER);\n1117\t  lv_obj_clear_flag(container, LV_OBJ_FLAG_SCROLL_ELASTIC);\n1118\t  watch->menu_container = container;\n1119\t\n1120\t  /* Place app icons in honeycomb pattern\n1121\t   *\n1122\t   * Row 0: 1 icon  (center)\n1123\t   * Row 1: 2 icons (offset)\n1124\t   * Row 2: 3 icons (offset)\n1125\t   * ...continuing the hex pattern\n1126\t   *\n1127\t   * For 4 apps: Row 0(1), Row 1(2), Row 2(1 centered)\n1128\t   */\n1129\t\n1130\t  idx = 0;\n1131\t  for (row = 0; row < 4 && idx < app_count; row++)\n1132\t    {\n1133\t      int icons_in_row;\n1134\t\n1135\t      if (row == 0)\n1136\t        {\n1137\t          icons_in_row = 1;\n1138\t        }\n1139\t      else\n1140\t        {\n1141\t          /* Hex pattern: alternating 2 and 3, but cap at remaining */\n1142\t\n1143\t          icons_in_row = row + 1;\n1144\t          if (icons_in_row > 3)\n1145\t            {\n1146\t              icons_in_row = 3;\n1147\t            }\n1148\t        }\n1149\t\n1150\t      if (icons_in_row == 1)\n1151\t        {\n1152\t          /* Single icon in center row */\n1153\t\n1154\t          if (idx >= app_count)\n1155\t            {\n1156\t              break;\n1157\t            }\n1158\t\n1159\t          row_width = 0;\n1160\t          icon_x = center_x;\n1161\t          icon_y = start_y + row * AI_WATCH_HEX_SPACING_Y +\n1162\t                   AI_WATCH_ICON_RADIUS;\n1163\t\n1164\t          /* Create hex icon */\n1165\t\n1166\t          {\n1167\t            FAR const struct ai_app_desc_s *app = &g_app_registry[idx];\n1168\t            FAR lv_obj_t *icon = lv_btn_create(container);\n1169\t            FAR lv_obj_t *icon_sym;\n1170\t            FAR lv_obj_t *icon_name;\n1171\t\n1172\t            lv_obj_set_size(icon, AI_WATCH_ICON_SIZE,\n1173\t                            AI_WATCH_ICON_SIZE);\n1174\t            lv_obj_set_pos(icon, icon_x - AI_WATCH_ICON_RADIUS,\n1175\t                           icon_y - AI_WATCH_ICON_RADIUS);\n1176\t            lv_obj_set_style_bg_color(icon,\n1177\t                                      ai_watch_theme_btn_bg(theme), 0);\n1178\t            lv_obj_set_style_radius(icon, AI_WATCH_ICON_RADIUS, 0);\n1179\t            lv_obj_set_style_border_width(icon, 2, 0);\n1180\t            lv_obj_set_style_border_color(icon,\n1181\t                                          ai_watch_theme_accent(theme), 0);\n1182\t            lv_obj_set_style_border_post(icon, true, 0);\n1183\t            lv_obj_set_user_data(icon, (void *)(intptr_t)idx);\n1184\t\n1185\t            /* Icon symbol */\n1186\t\n1187\t            icon_sym = lv_label_create(icon);\n1188\t            lv_label_set_text(icon_sym, app->icon_symbol);\n1189\t            lv_obj_set_style_text_color(icon_sym,\n1190\t                                        ai_watch_theme_text(theme), 0);\n1191\t            lv_obj_set_style_text_font(icon_sym, &lv_font_montserrat_28, 0);\n1192\t            lv_obj_align(icon_sym, LV_ALIGN_CENTER, 0, -10);\n1193\t\n1194\t            /* App name */\n1195\t\n1196\t            icon_name = lv_label_create(icon);\n1197\t            lv_label_set_text(icon_name, app->name);\n1198\t            lv_obj_set_style_text_color(icon_name,\n1199\t                                        ai_watch_theme_text(theme), 0);\n1200\t            lv_obj_set_style_text_font(icon_name, &lv_font_montserrat_16, 0);\n1201\t            lv_obj_align(icon_name, LV_ALIGN_CENTER, 0, 15);\n1202\t\n1203\t            /* Gray out unavailable apps */\n1204\t\n1205\t            if (!app->available)\n1206\t              {\n1207\t                lv_obj_set_style_bg_opa(icon, LV_OPA_50, 0);\n1208\t                lv_obj_set_style_text_opa(icon_sym, LV_OPA_50, 0);\n1209\t                lv_obj_set_style_text_opa(icon_name, LV_OPA_50, 0);\n1210\t              }\n1211\t\n1212\t            lv_obj_add_event_cb(icon, ai_watch_app_icon_cb,\n1213\t                                LV_EVENT_CLICKED, watch);\n1214\t          }\n1215\t\n1216\t          idx++;\n1217\t        }\n1218\t      else\n1219\t        {\n1220\t          /* Multiple icons in row - hex offset pattern */\n1221\t\n1222\t          int row_icons = icons_in_row;\n1223\t\n1224\t          if (row_icons > app_count - idx)\n1225\t            {\n1226\t              row_icons = app_count - idx;\n1227\t            }\n1228\t\n1229\t          row_width = (row_icons - 1) * AI_WATCH_HEX_SPACING_X;\n1230\t\n1231\t          for (col = 0; col < row_icons && idx < app_count; col++)\n1232\t            {\n1233\t              FAR const struct ai_app_desc_s *app = &g_app_registry[idx];\n1234\t              FAR lv_obj_t *icon;\n1235\t              FAR lv_obj_t *icon_sym;\n1236\t              FAR lv_obj_t *icon_name;\n1237\t\n1238\t              icon_x = center_x - row_width / 2 +\n1239\t                       col * AI_WATCH_HEX_SPACING_X;\n1240\t              icon_y = start_y + row * AI_WATCH_HEX_SPACING_Y +\n1241\t                       AI_WATCH_ICON_RADIUS;\n1242\t\n1243\t              icon = lv_btn_create(container);\n1244\t              lv_obj_set_size(icon, AI_WATCH_ICON_SIZE,\n1245\t                              AI_WATCH_ICON_SIZE);\n1246\t              lv_obj_set_pos(icon, icon_x - AI_WATCH_ICON_RADIUS,\n1247\t                             icon_y - AI_WATCH_ICON_RADIUS);\n1248\t              lv_obj_set_style_bg_color(icon,\n1249\t                                        ai_watch_theme_btn_bg(theme), 0);\n1250\t              lv_obj_set_style_radius(icon, AI_WATCH_ICON_RADIUS, 0);\n1251\t              lv_obj_set_style_border_width(icon, 2, 0);\n1252\t              lv_obj_set_style_border_color(icon,\n1253\t                                            ai_watch_theme_accent(theme), 0);\n1254\t              lv_obj_set_style_border_post(icon, true, 0);\n1255\t              lv_obj_set_user_data(icon, (void *)(intptr_t)idx);\n1256\t\n1257\t              /* Icon symbol */\n1258\t\n1259\t              icon_sym = lv_label_create(icon);\n1260\t              lv_label_set_text(icon_sym, app->icon_symbol);\n1261\t              lv_obj_set_style_text_color(icon_sym,\n1262\t                                          ai_watch_theme_text(theme), 0);\n1263\t              lv_obj_set_style_text_font(icon_sym,\n1264\t                                         &lv_font_montserrat_28, 0);\n1265\t              lv_obj_align(icon_sym, LV_ALIGN_CENTER, 0, -10);\n1266\t\n1267\t              /* App name */\n1268\t\n1269\t              icon_name = lv_label_create(icon);\n1270\t              lv_label_set_text(icon_name, app->name);\n1271\t              lv_obj_set_style_text_color(icon_name,\n1272\t                                          ai_watch_theme_text(theme), 0);\n1273\t              lv_obj_set_style_text_font(icon_name,\n1274\t                                         &lv_font_montserrat_16, 0);\n1275\t              lv_obj_align(icon_name, LV_ALIGN_CENTER, 0, 15);\n1276\t\n1277\t              /* Gray out unavailable apps */\n1278\t\n1279\t              if (!app->available)\n1280\t                {\n1281\t                  lv_obj_set_style_bg_opa(icon, LV_OPA_50, 0);\n1282\t                  lv_obj_set_style_text_opa(icon_sym, LV_OPA_50, 0);\n1283\t                  lv_obj_set_style_text_opa(icon_name, LV_OPA_50, 0);\n1284\t                }\n1285\t\n1286\t              lv_obj_add_event_cb(icon, ai_watch_app_icon_cb,\n1287\t                                  LV_EVENT_CLICKED, watch);\n1288\t\n1289\t              idx++;\n1290\t            }\n1291\t        }\n1292\t    }\n1293\t\n1294\t  /* Set scrollable content height */\n1295\t\n1296\t  total_height = (app_count > 0) ?\n1297\t                 (start_y + 4 * AI_WATCH_HEX_SPACING_Y + 40) :\n1298\t                 AI_WATCH_SCREEN_HEIGHT;\n1299\t  lv_obj_set_content_height(container, total_height);\n1300\t\n1301\t  /* Back hint */\n1302\t\n1303\t  hint = lv_label_create(screen);\n1304\t  lv_label_set_text(hint, LV_SYMBOL_LEFT \" Back (KEY2)\");\n1305\t  lv_obj_set_style_text_color(hint, ai_watch_theme_secondary(theme), 0);\n1306\t  lv_obj_set_style_text_font(hint, &lv_font_montserrat_16, 0);\n1307\t  lv_obj_align(hint, LV_ALIGN_BOTTOM_MID, 0, -5);\n1308\t}\n1309\t\n1310\t/****************************************************************************\n1311\t * Private Functions - About/Init\n1312\t ****************************************************************************/\n1313\t\n1314\tstatic void ai_watch_init_about(FAR struct ai_watch_s *watch)\n1315\t{\n1316\t  char about[128];\n1317\t  struct timespec ts;\n1318\t  struct tm tm;\n1319\t  bool rtc_ok = false;\n1320\t\n1321\t  if (clock_gettime(CLOCK_REALTIME, &ts) == 0 &&\n1322\t      localtime_r(&ts.tv_sec, &tm) != NULL &&\n1323\t      tm.tm_year + 1900 >= AI_WATCH_RTC_MIN_YEAR)\n1324\t    {\n1325\t      char time[16];\n1326\t\n1327\t      strftime(time, sizeof(time), \"%H:%M:%S\", &tm);\n1328\t      snprintf(about, sizeof(about),\n1329\t               \"AI Watch v\" AI_WATCH_VERSION \"\\n\"\n1330\t               \"Board: SF32LB52\\n\"\n1331\t               \"Touch: %s\\n\"\n1332\t               \"RTC: %s\",\n1333\t               watch->touch_available ? \"Active\" : \"Unavailable\",\n1334\t               time);\n1335\t      rtc_ok = true;\n1336\t    }\n1337\t  else\n1338\t    {\n1339\t      snprintf(about, sizeof(about),\n1340\t               \"AI Watch v\" AI_WATCH_VERSION \"\\n\"\n1341\t               \"Board: SF32LB52\\n\"\n1342\t               \"Touch: %s\\n\"\n1343\t               \"RTC: Not set\",\n1344\t               watch->touch_available ? \"Active\" : \"Unavailable\");\n1345\t    }\n1346\t\n1347\t  lv_label_set_text(watch->about_label, about);\n1348\t\n1349\t  if (rtc_ok)\n1350\t    {\n1351\t      watch->rtc_valid = true;\n1352\t      watch->displayed_second = ts.tv_sec;\n1353\t    }\n1354\t  else\n1355\t    {\n1356\t      watch->rtc_valid = false;\n1357\t      watch->rtc_warning_printed = true;\n1358\t      printf(\"RTC time is not set; waiting for time synchronization\\n\");\n1359\t    }\n1360\t}\n1361\t\n1362\tstatic void ai_watch_create_ui(FAR struct ai_watch_s *watch)\n1363\t{\n1364\t  /* Initialize page manager */\n1365\t\n1366\t  ai_watch_page_manager_init(watch);\n1367\t\n1368\t  /* Create all fixed pages */\n1369\t\n1370\t  ai_watch_create_home_page(watch);\n1371\t  ai_watch_create_app_list_page(watch);\n1372\t  ai_watch_create_settings_page(watch);\n1373\t\n1374\t  /* Load home page as active screen */\n1375\t\n1376\t  lv_scr_load_anim(watch->fixed_pages[AI_WATCH_PAGE_HOME],\n1377\t                   LV_SCR_LOAD_ANIM_NONE, 0, 0, false);\n1378\t\n1379\t  /* Initialize About label */\n1380\t\n1381\t  ai_watch_init_about(watch);\n1382\t  ai_watch_time_update(watch);\n1383\t\n1384\t  printf(\"UI created with %d fixed pages, %d registered apps\\n\",\n1385\t         AI_WATCH_PAGE_FIXED_COUNT, (int)AI_WATCH_APP_COUNT);\n1386\t}\n1387\t\n1388\t/****************************************************************************\n1389\t * Private Functions - Button Input\n1390\t ****************************************************************************/\n1391\t\n1392\tstatic int ai_watch_button_initialize(FAR struct ai_watch_s *watch)\n1393\t{\n1394\t  btn_buttonset_t sample;\n1395\t  ssize_t nread;\n1396\t  int ret;\n1397\t\n1398\t  watch->button_fd = open(AI_WATCH_BUTTON_DEVICE, O_RDONLY | O_NONBLOCK);\n1399\t  if (watch->button_fd < 0)\n1400\t    {\n1401\t      int errcode = errno;\n1402\t\n1403\t      printf(\"ERROR: Failed to open %s: %d\\n\",\n1404\t             AI_WATCH_BUTTON_DEVICE, errcode);\n1405\t      return -errcode;\n1406\t    }\n1407\t\n1408\t  ret = ioctl(watch->button_fd, BTNIOC_SUPPORTED,\n1409\t              (unsigned long)((uintptr_t)&watch->supported_buttons));\n1410\t  if (ret < 0)\n1411\t    {\n1412\t      int errcode = errno;\n1413\t\n1414\t      printf(\"ERROR: BTNIOC_SUPPORTED failed: %d\\n\", errcode);\n1415\t      close(watch->button_fd);\n1416\t      watch->button_fd = -1;\n1417\t      return -errcode;\n1418\t    }\n1419\t\n1420\t  nread = read(watch->button_fd, &sample, sizeof(sample));\n1421\t  if (nread != sizeof(sample))\n1422\t    {\n1423\t      int errcode = nread < 0 ? errno : EIO;\n1424\t\n1425\t      printf(\"ERROR: Initial button read failed: %d\\n\", errcode);\n1426\t      close(watch->button_fd);\n1427\t      watch->button_fd = -1;\n1428\t      return -errcode;\n1429\t    }\n1430\t\n1431\t  clock_gettime(CLOCK_MONOTONIC, &watch->next_button_poll);\n1432\t  watch->button_raw_since = watch->next_button_poll;\n1433\t  watch->button_raw_pressed = (sample & AI_WATCH_BUTTON_KEY2) != 0;\n1434\t  watch->button_armed = !watch->button_raw_pressed;\n1435\t\n1436\t  printf(\"Supported buttons: 0x%02lx\\n\",\n1437\t         (unsigned long)watch->supported_buttons);\n1438\t  printf(\"KEY2 button monitor started\\n\");\n1439\t  return OK;\n1440\t}\n1441\t\n1442\tstatic void ai_watch_button_update(FAR struct ai_watch_s *watch,\n1443\t                                   FAR const struct timespec *now)\n1444\t{\n1445\t  btn_buttonset_t sample;\n1446\t  bool pressed;\n1447\t  ssize_t nread;\n1448\t\n1449\t  if (watch->button_fd < 0 ||\n1450\t      !ai_watch_deadline_reached(now, &watch->next_button_poll))\n1451\t    {\n1452\t      return;\n1453\t    }\n1454\t\n1455\t  watch->next_button_poll = *now;\n1456\t  ai_watch_advance_deadline(&watch->next_button_poll,\n1457\t                            AI_WATCH_BUTTON_POLL_MS);\n1458\t\n1459\t  nread = read(watch->button_fd, &sample, sizeof(sample));\n1460\t  if (nread != sizeof(sample))\n1461\t    {\n1462\t      if (nread < 0 && errno != EAGAIN && errno != EINTR)\n1463\t        {\n1464\t          printf(\"ERROR: Button read failed: %d\\n\", errno);\n1465\t        }\n1466\t\n1467\t      return;\n1468\t    }\n1469\t\n1470\t  pressed = (sample & AI_WATCH_BUTTON_KEY2) != 0;\n1471\t  if (pressed != watch->button_raw_pressed)\n1472\t    {\n1473\t      watch->button_raw_pressed = pressed;\n1474\t      watch->button_raw_since = *now;\n1475\t    }\n1476\t\n1477\t  if (pressed)\n1478\t    {\n1479\t      if (watch->button_armed)\n1480\t        {\n1481\t          watch->button_armed = false;\n1482\t\n1483\t          /* KEY2 acts as back button / BT toggle on home */\n1484\t\n1485\t          if (watch->current_page == AI_WATCH_PAGE_HOME)\n1486\t            {\n1487\t              ai_watch_update_bt_state(watch, !watch->bt_state);\n1488\t              printf(\"KEY2 pressed: BT %s\\n\",\n1489\t                     watch->bt_state ? \"ON\" : \"OFF\");\n1490\t            }\n1491\t          else\n1492\t            {\n1493\t              ai_watch_pop_page(watch);\n1494\t              printf(\"KEY2 pressed: Back\\n\");\n1495\t            }\n1496\t        }\n1497\t    }\n1498\t  else if (ai_watch_elapsed_ms(now, &watch->button_raw_since) >=\n1499\t           AI_WATCH_BUTTON_RELEASE_MS)\n1500\t    {\n1501\t      watch->button_armed = true;\n1502\t    }\n1503\t}\n1504\t\n1505\t/****************************************************************************\n1506\t * Private Functions - Time Update\n1507\t ****************************************************************************/\n1508\t\n1509\tstatic void ai_watch_time_update(FAR struct ai_watch_s *watch)\n1510\t{\n1511\t  char date[32];\n1512\t  char time_hm[8];\n1513\t  char time_sec[8];\n1514\t  char dow[8];\n1515\t  char about[128];\n1516\t  struct timespec ts;\n1517