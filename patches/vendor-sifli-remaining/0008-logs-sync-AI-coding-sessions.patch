bgra[i] = b; bgra[i+1] = g; bgra[i+2] = r; bgra[i+3] = a\n    data = bytes(bgra)\n    total_bytes += len(data)\n\n    lines.append(f\"static const uint8_t icon_{name}_data[] = {{\")\n    row = \"    \"\n    for i, byte in enumerate(data):\n        row += f\"0x{byte:02x},\"\n        if (i + 1) % 16 == 0:\n            lines.append(row)\n            row = \"    \"\n    if row.strip():\n        lines.append(row)\n    lines.append(\"};\")\n    lines.append(\"\")\n\nfor name, _ in icons:\n    lines.append(f\"const lv_image_dsc_t icon_{name} = {{\")\n    lines.append(f\"  .header = {{\")\n    lines.append(f\"    .magic = LV_IMAGE_HEADER_MAGIC,\")\n    lines.append(f\"    .cf = LV_COLOR_FORMAT_ARGB8888,\")\n    lines.append(f\"    .flags = 0,\")\n    lines.append(f\"    .w = 128,\")\n    lines.append(f\"    .h = 128,\")\n    lines.append(f\"    .stride = 512,\")\n    lines.append(f\"    .reserved_2 = 0,\")\n    lines.append(f\"  }},\")\n    lines.append(f\"  .data_size = {128 * 128 * 4},\")\n    lines.append(f\"  .data = icon_{name}_data,\")\n    lines.append(f\"  .reserved = 0,\")\n    lines.append(f\"  .reserved_2 = 0,\")\n    lines.append(f\"}};\")\n    lines.append(\"\")\n\nwith open(DST, \"w\") as f:\n    f.write(\"\\n\".join(lines))\n\nprint(f\"Generated {len(lines)} lines, {total_bytes} bytes icon data\")\nprint(f\"Per icon: {total_bytes // len(icons)} bytes ({total_bytes // len(icons) // 1024} KB)\")\nPYEOF", "description": "Convert 128x128 PNG icons to C arrays", "timeout": 30000}, "output": null}
