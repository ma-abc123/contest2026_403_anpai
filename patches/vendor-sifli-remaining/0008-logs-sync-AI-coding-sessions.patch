 4):\n            r, g, b, a = pixels[i], pixels[i+1], pixels[i+2], pixels[i+3]\n            bgra[i] = b; bgra[i+1] = g; bgra[i+2] = r; bgra[i+3] = a\n        data = bytes(bgra)\n        total += len(data)\n\n        sym = f\"icon_{name}{suffix}\"\n        lines.append(f\"static const uint8_t {sym}_data[] = {{\")\n        row = \"    \"\n        for i, byte in enumerate(data):\n            row += f\"0x{byte:02x},\"\n            if (i + 1) % 16 == 0:\n                lines.append(row)\n                row = \"    \"\n        if row.strip():\n            lines.append(row)\n        lines.append(\"};\")\n        lines.append(\"\")\n\n# Image descriptors\nfor name, _ in ICONS:\n    for suffix, size in TIERS:\n        sym = f\"icon_{name}{suffix}\"\n        stride = size * 4\n        datasize = size * size * 4\n        lines.append(f\"const lv_image_dsc_t {sym} = {{\")\n        lines.append(f\"  .header = {{\")\n        lines.append(f\"    .magic = LV_IMAGE_HEADER_MAGIC,\")\n        lines.append(f\"    .cf = LV_COLOR_FORMAT_ARGB8888,\")\n        lines.append(f\"    .flags = 0,\")\n        lines.append(f\"    .w = {size},\")\n        lines.append(f\"    .h = {size},\")\n        lines.append(f\"    .stride = {stride},\")\n        lines.append(f\"    .reserved_2 = 0,\")\n        lines.append(f\"  }},\")\n        lines.append(f\"  .data_size = {datasize},\")\n        lines.append(f\"  .data = {sym}_data,\")\n        lines.append(f\"  .reserved = 0,\")\n        lines.append(f\"  .reserved_2 = 0,\")\n        lines.append(f\"}};\")\n        lines.append(\"\")\n\nwith open(DST, \"w\") as f:\n    f.write(\"\\n\".join(lines))\n\nprint(f\"Total icon data: {total} bytes ({total // 1024} KB)\")\nfor suffix, size in TIERS:\n    per = size * size * 4\n    print(f\"  {suffix} ({size}x{size}): {per * 4} bytes ({per * 4 // 1024} KB)\")\nPYEOF", "description": "Generate pre-scaled icons at 5 sizes", "timeout": 30000}, "output": null}
