d target is `Xconfig`\n140\t  for arg in \"${@:2}\"\n141\t  do\n142\t    if [[ $arg == *config ]]; then\n143\t      if ! m $arg; then\n144\t        echo \"Error: #############  m $arg fail ##############\"\n145\t        exit 2\n146\t      else\n147\t        return 0\n148\t      fi\n149\t    fi\n150\t    if [[ \"$arg\" =~ ^V=1$ ]]; then\n151\t      v_arg+=\"V=1\"\n152\t    fi\n153\t  done\n154\t  # do cmake build\n155\t  if ! m $j_arg $v_arg; then\n156\t    echo \"Error: ############# build ${1} fail ##############\"\n157\t    exit 2\n158\t  fi\n159\t}\n160\t\n161\t\n162\tfunction setup_cmake_binary_dir()\n163\t{\n164\t  local boardconfig=$1\n165\t  if [ -d ${ROOTDIR}/${boardconfig} ]; then\n166\t    # parse path config\n167\t    config_name=$(basename \"$boardconfig\")\n168\t    board_name=$(basename $(dirname $(dirname \"$boardconfig\")))\n169\t  else\n170\t    # parse nuttx config pair\n171\t    config_name=`echo ${boardconfig} | cut -s -d':' -f2`\n172\t    if [ -z \"${config_name}\" ]; then\n173\t      board_name=`echo ${boardconfig} | cut -d'/' -f1`\n174\t      config_name=`echo ${boardconfig} | cut -d'/' -f2`\n175\t    else\n176\t      board_name=`echo ${boardconfig} | cut -d':' -f1`\n177\t    fi\n178\t  fi\n179\t  CMAKE_BINARY_DIR+=\"/${board_name}_${config_name}\"\n180\t}\n181\t\n182\tif [ $# == 0 ]; then\n183\t  echo \"Usage: $0 [-m] <board-name>:<config-name> [-e <extraflags>] [--cmake] [-b <cmake_binary_dir>] [--dis-ninja] [make options]\"\n184\t  echo \"\"\n185\t  echo \"Where:\"\n186\t  echo \"  -m: out of tree build. Or default in tree build without it.\"\n187\t  echo \"  -e: pass extra c/c++ flags such as -Werror via make command line\"\n188\t  echo \"  --cmake: switch the build mode to CMake compilation.\"\n189\t  echo \"  -b: set custom binary directory for CMake.\"\n190\t  echo \"  --dis-ninja: disable CMake Ninja generator fo default.\"\n191\t  echo \"  -c: set custom toolchain.\"\n192\t  exit 1\n193\tfi\n194\t\n195\tROOTDIR=$(dirname $(readlink -f