ust to let the system breathe */\n509\t            }\n510\t        }\n511\t        else\n512\t#endif  /* BSP_USING_PM */\n513\t        {\n514\t            //EventStartB(0);\n515\t            if (ms > 0)\n516\t                rt_thread_mdelay(ms);       /* Just to let the system breathe */\n517\t            //EventStopB(0);\n518\t        }\n519\t\n520\t        if (first_loop)\n521\t        {\n522\t#ifndef WIN32\n523\t            //Turn on lcd backlight after power on\n524\t            uint8_t brightness = 100;\n525\t            rt_device_control(lcd_device, RTGRAPHIC_CTRL_SET_BRIGHTNESS, &brightness);\n526\t#endif /* WIN32 */\n527\t            first_loop = 0;\n528\t        }\n529\t    }\n530\t\n531\t}\n532\t\n533\tvoid app_register(void)\n534\t{\n535\t}\n536\t\n537\tint app_watch_init(void)\n538\t{\n539\t    rt_err_t ret = RT_EOK;\n540\t    rt_thread_t thread = RT_NULL;\n541\t\n542\t\n543\t    ret = rt_thread_init(&watch_thread, \"app_watch\", app_watch_entry, RT_NULL, watch_thread_stack, APP_WATCH_GUI_TASK_STACK_SIZE,\n544\t                         RT_THREAD_PRIORITY_MIDDLE, RT_THREAD_TICK_DEFAULT);\n545\t\n546\t    if (RT_EOK != ret)\n547\t    {\n548\t        return RT_ERROR;\n549\t    }\n550\t    rt_thread_startup(&watch_thread);\n551\t    return RT_EOK;\n552\t}\n553\t\n554\t#if !defined (_MSC_VER)\n555\t#define APP_MEM_THRESHOLD 16384\n556\tvoid *cxx_mem_allocate(size_t size)\n557\t{\n558\t    if (size > APP_MEM_THRESHOLD)\n559\t    {\n560\t        void *p = app_anim_mem_alloc(size, 1);\n561\t        rt_kprintf(\"Allocate %d, %p\\n\", size, p);\n562\t        return p;\n563\t    }\n564\t    else\n565\t        return rt_malloc(size);\n566\t}\n567\t\n568\textern int rt_in_system_heap(void *ptr);\n569\tvoid cxx_mem_free(void *ptr)\n570\t{\n571\t    if (rt_in_system_heap(ptr))\n572\t        rt_free(ptr);\n573\t    else\n574\t    {\n575\t        rt_kprintf(\"Free %p\\n\", ptr);\n576\t        app_anim_mem_free(ptr);\n577\t    }\n578\t}\n579\t#endif\n580\t\n581\tINIT_APP