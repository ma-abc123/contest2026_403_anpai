tp_ready)\n          {\n            break;\n          }\n\n        usleep(100000); /* 100 ms */\n      }\n\n    if (!lcd_ready)\n      {\n        printf(\"WARNING: /dev/lcd0 not found after 5s\\n\");\n      }\n\n    if (!tp_ready)\n      {\n        printf(\"WARNING: /dev/input0 not found after 5s\\n\");\n      }\n  }"}, "output": null}
