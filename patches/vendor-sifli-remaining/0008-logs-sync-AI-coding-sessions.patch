gistry entry */\n105\t\n106\ttypedef void (*ai_app_create_cb_t)(FAR struct ai_watch_s *watch);\n107\ttypedef void (*ai_app_destroy_cb_t)(FAR struct ai_watch_s *watch);\n108\t\n109\tstruct ai_app_desc_s\n110\t{\n111\t  FAR const char *name;\n112\t  FAR const char *icon_symbol;\n113\t  ai_app_create_cb_t create_cb;\n114\t  ai_app_destroy_cb_t destroy_cb;\n115\t  bool available;\n116\t};\n117\t\n118\t/* Timer state */\n119\t\n120\tstruct ai_timer_state_s\n121\t{\n122\t  FAR lv_obj_t *time_label;\n123\t  FAR lv_timer_t *update_timer;\n124\t  uint32_t start_tick;\n125\t  uint32_t elapsed_ms;\n126\t  bool running;\n127\t};\n128\t\n129\t/* Main watch state */\n130\t\n131\tstruct ai_watch_s\n132\t{\n133\t  /* Display objects - Home page */\n134\t\n135\t  FAR lv_obj_t *home_screen;\n136\t  FAR lv_obj_t *time_label;\n137\t  FAR lv_obj_t *seconds_label;\n138\t  FAR lv_obj_t *date_label;\n139\t  FAR lv_obj_t *dow_label;\n140\t  FAR lv_obj_t *bt_label;\n141\t\n142\t  /* Display objects - App list page */\n143\t\n144\t  FAR lv_obj_t *app_list_screen;\n145\t  FAR lv_obj_t *menu_container;\n146\t\n147\t  /* Display objects - Settings page */\n148\t\n149\t  FAR lv_obj_t *settings_screen;\n150\t  FAR lv_obj_t *bt_switch;\n151\t  FAR lv_obj_t *theme_roller;\n152\t  FAR lv_obj_t *about_label;\n153\t\n154\t  /* Display objects - Dynamic app page */\n155\t\n156\t  FAR lv_obj_t *app_page_screen;\n157\t\n158\t  /* Page navigation */\n159\t\n160\t  int current_page;\n161\t  FAR lv_obj_t *fixed_pages[AI_WATCH_PAGE_FIXED_COUNT];\n162\t  int page_stack[AI_WATCH_PAGE_STACK_MAX];\n163\t  int page_stack_top;\n164\t\n165\t  /* Button state */\n166\t\n167\t  int button_fd;\n168\t  btn_buttonset_t supported_buttons;\n169\t  struct timespec button_raw_since;\n170\t  struct timespec next_button_poll;\n171\t  bool button_raw_pressed;\n172\t  bool button_armed;\n173\t\n174\t  /* Touch/swipe state */\n175\t\n176\t  bool touch_active;\n177\t  bool touch_available;\n178\t  int touch_start_x;\n179\t  int touch_start_y;\n180\t  struct timespec touch_start_time;\n181\t\n182\t  /* RTC state */\n183\t\n184\t  time_t displayed_second;\n185\t  bool rtc_valid;\n186\t  bool rtc_warning_printed;\n187\t\n188\t  /* Application state */\n189\t\n190\t  bool bt_state;\n191\t  bool settings_bt_enabled;\n192\t  int current_theme;\n193\t\n194\t  /* Timer state */\n195\t\n196\t  struct ai_timer_state_s timer;\n197\t};\n198\t\n199\t/****************************************************************************\n200\t * Private Function Prototypes\n201\t ****************************************************************************/\n202\t\n203\tstatic void ai_watch_push_page(FAR struct ai_watch_s *watch, int page);\n204\tstatic void ai_watch_pop_page(FAR struct ai_watch_s *watch);\n205\tstatic void ai_watch_open_app(FAR struct ai_watch_s *watch, int app_index);\n206\tstatic void ai_watch_close_app(FAR struct ai_watch_s *watch);\n207\tstatic void ai_watch_update_bt_state(FAR struct ai_watch_s *watch,\n208\t                                     bool new_state);\n209\tstatic void ai_watch_update_theme(FAR struct ai_watch_s *watch, int theme);\n210\tstatic void ai_watch_create_home_page(FAR struct ai_watch_s *watch);\n211\tstatic void ai_watch_create_app_list_page(FAR struct ai_watch_s *watch);\n212\tstatic void ai_watch_create_settings_page(FAR struct ai_watch_s *watch);\n213\tstatic void ai_watch_create_timer_app(FAR struct ai_watch_s *watch);\n214\tstatic void ai_watch_destroy_timer_app(FAR struct ai_watch_s *watch);\n215\tstatic void ai_watch_timer_update_cb(FAR lv_timer_t *timer);\n216\tstatic void ai_watch_time_update(FAR struct ai_watch_s *watch);\n217\t\n218\t/****************************************************************************\n219\t * Private Data - App Registry\n220\t ****************************************************************************/\n221\t\n222\tstatic const struct ai_app_desc_s g_app_registry[] =\n223\t{\n224\t  {\n225\t    \"Exercise\", LV_SYMBOL_PLAY,\n226\t    NULL, NULL, false\n227\t  },\n228\t  {\n229\t    \"Timer\", LV_SYMBOL_PAUSE,\n230\t    ai_watch_create_timer_app, ai_watch_destroy_timer_app, true\n231\t  },\n232\t  {\n233\t    \"Reminder\", LV_SYMBOL_BELL,\n234\t    NULL, NULL, false\n235\t  },\n236\t  {\n237\t    \"Settings\", LV_SYMBOL_SETTINGS,\n238\t    NULL, NULL, true\n239\t  },\n240\t};\n241\t\n242\t#define AI_WATCH_APP_COUNT \\\n243\t  (sizeof(g_app_registry) / sizeof(g_app_registry[0]))\n244\t\n245\t/****************************************************************************\n246\t * Private Functions - Utilities\n247\t ****************************************************************************/\n248\t\n249\tstatic int64_t ai_watch_elapsed_ms(FAR const struct timespec *now,\n250\t                                   FAR const struct timespec *then)\n251\t{\n252\t  return (int64_t)(now->tv_sec - then->tv_sec) * 1000 +\n253\t         (now->tv_nsec - then->tv_nsec) / 1000000;\n254\t}\n255\t\n256\tstatic bool ai_watch_deadline_reached(FAR const struct timespec *now,\n257\t                                      FAR const struct timespec *deadline)\n258\t{\n259\t  return now->tv_sec > deadline->tv_sec ||\n260\t         (now->tv_sec == deadline->tv_sec &&\n261\t          now->tv_nsec >= deadline->tv_nsec);\n262\t}\n263\t\n264\tstatic void ai_watch_advance_deadline(FAR struct timespec *deadline,\n265\t                                      long delay_ms)\n266\t{\n267\t  deadline->tv_nsec += delay_ms * 1000000;\n268\t  deadline->tv_sec += deadline->tv_nsec / 1000000000;\n269\t  deadline->tv_nsec %= 1000000000;\n270\t}\n271\t\n272\tstatic int ai_watch_day_of_week(int year, int month, int day)\n273\t{\n274\t  static const int t[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};\n275\t\n276\t  if (month < 3)\n277\t    {\n278\t      year--;\n279\t    }\n280\t\n281\t  return (year + year / 4 - year / 100 + year / 400 +\n282\t          t[month - 1] + day) % 7;\n283\t}\n284\t\n285\t/****************************************************************************\n286\t * Private Functions - Theme Management\n287\t ****************************************************************************/\n288\t\n289\tstatic lv_color_t ai_watch_theme_bg(int theme)\n290\t{\n291\t  switch (theme)\n292\t    {\n293\t      case AI_WATCH_THEME_LIGHT:\n294\t        return lv_color_white();\n295\t      case AI_WATCH_THEME_BLUE:\n296\t        return lv_color_make(10, 25, 50);\n297\t      case AI_WATCH_THEME_DARK:\n298\t      default:\n299\t        return lv_color_black();\n300\t    }\n301\t}\n302\t\n303\tstatic lv_color_t ai_watch_theme_text(int theme)\n304\t{\n305\t  switch (theme)\n306\t    {\n307\t      case AI_WATCH_THEME_LIGHT:\n308\t        return lv_color_black();\n309\t      case AI_WATCH_THEME_BLUE:\n310\t        return lv_color_make(200, 220, 255);\n311\t      case AI_WATCH_THEME_DARK:\n312\t      default:\n313\t        return lv_color_white();\n314\t    }\n315\t}\n316\t\n317\tstatic lv_color_t ai_watch_theme_accent(int theme)\n318\t{\n319\t  switch (theme)\n320\t    {\n321\t      case AI_WATCH_THEME_LIGHT:\n322\t        return lv_color_make(0, 122, 255);\n323\t      case AI_WATCH_THEME_BLUE:\n324\t        return lv_color_make(100, 180, 255);\n325\t      case AI_WATCH_THEME_DARK:\n326\t      default:\n327\t        return lv_color_make(0, 191, 255);\n328\t    }\n329\t}\n330\t\n331\tstatic lv_color_t ai_watch_theme_secondary(int theme)\n332\t{\n333\t  switch (theme)\n334\t    {\n335\t      case AI_WATCH_THEME_LIGHT:\n336\t        return lv_color_make(100, 100, 100);\n337\t      case AI_WATCH_THEME_BLUE:\n338\t        return lv_color_make(120, 150, 200);\n339\t      case AI_WATCH_THEME_DARK:\n340\t      default:\n341\t        return lv_color_make(180, 180, 180);\n342\t    }\n343\t}\n344\t\n345\tstatic lv_color_t ai_watch_theme_btn_bg(int theme)\n346\t{\n347\t  switch (theme)\n348\t    {\n349\t      case AI_WATCH_THEME_LIGHT:\n350\t        return lv_color_make(230, 230, 230);\n351\t      case AI_WATCH_THEME_BLUE:\n352\t        return lv_color_make(20, 45, 80);\n353\t      case AI_WATCH_THEME_DARK:\n354\t      default:\n355\t        return lv_color_make(40, 40, 40);\n356\t    }\n357\t}\n358\t\n359\tstatic void ai_watch_update_theme(FAR struct ai_watch_s *watch, int theme)\n360\t{\n361\t  uint32_t home_child_count;\n362\t  uint32_t app_child_count;\n363\t  uint32_t settings_child_count;\n364\t  uint32_t i;\n365\t\n366\t  if (theme < 0 || theme >= AI_WATCH_THEME_COUNT ||\n367\t      theme == watch->current_theme)\n368\t    {\n369\t      return;\n370\t    }\n371\t\n372\t  watch->current_theme = theme;\n373\t  printf(\"Theme changed to %d\\n\", theme);\n374\t\n375\t  /* Update Home page */\n376\t\n377\t  lv_obj_set_style_bg_color(watch->home_screen,\n378\t                            ai_watch_theme_bg(theme), 0);\n379\t  lv_obj_set_style_text_color(\n380\t      lv_obj_get_child(watch->home_screen, 0),\n381\t      ai_watch_theme_text(theme), 0);\n382\t  lv_obj_set_style_text_color(watch->time_label,\n383\t                              ai_watch_theme_text(theme), 0);\n384\t  lv_obj_set_style_text_color(watch->seconds_label,\n385\t                              ai_watch_theme_secondary(theme), 0);\n386\t  lv_obj_set_style_text_color(watch->date_label,\n387\t                              ai_watch_theme_secondary(theme), 0);\n388\t  lv_obj_set_style_text_color(watch->dow_label,\n389\t                              ai_watch_theme_secondary(theme), 0);\n390\t  lv_obj_set_style_text_color(watch->bt_label,\n391\t                              ai_watch_theme_accent(theme), 0);\n392\t\n393\t  home_child_count = lv_obj_get_child_count(watch->home_screen);\n394\t  if (home_child_count > 0)\n395\t    {\n396\t      lv_obj_set_style_text_color(\n397\t          lv_obj_get_child(watch->home_screen, home_child_count - 1),\n398\t          ai_watch_theme_secondary(theme), 0);\n399\t    }\n400\t\n401\t  /* Update App List page */\n402\t\n403\t  lv_obj_set_style_bg_color(watch->app_list_screen,\n404\t                            ai_watch_theme_bg(theme), 0);\n405\t  lv_obj_set_style_text_color(\n406\t      lv_obj_get_child(watch->app_list_screen, 0),\n407\t      ai_watch_theme_text(theme), 0);\n408\t\n409\t  if (watch->menu_container != NULL)\n410\t    {\n411\t      uint32_t icon_count =\n412\t          lv_obj_get_child_count(watch->menu_container);\n413\t      uint32_t j;\n414\t\n415\t      lv_obj_set_style_bg_color(watch->menu_container,\n416\t                                ai_watch_theme_bg(theme), 0);\n417\t\n418\t      for (j = 0; j < icon_count; j++)\n419\t        {\n420\t          FAR lv_obj_t *icon =\n421\t              lv_obj_get_child(watch->menu_container, j);\n422\t\n423\t          lv_obj_set_style_bg_color(icon,\n424\t                                    ai_watch_theme_btn_bg(theme), 0);\n425\t          lv_obj_set_style_border_color(icon,\n426\t                                        ai_watch_theme_accent(theme), 0);\n427\t\n428\t          uint32_t btn_child = lv_obj_get_child_count(icon);\n429\t          uint32_t k;\n430\t\n431\t          for (k = 0; k < btn_child; k++)\n432\t            {\n433\t              lv_obj_set_style_text_color(\n434\t                  lv_obj_get_child(icon, k),\n435\t                  ai_watch_theme_text(theme), 0);\n436\t            }\n437\t        }\n438\t    }\n439\t\n440\t  app_child_count = lv_obj_get_child_count(watch->app_list_screen);\n441\t  if (app_child_count > 0)\n442\t    {\n443\t      lv_obj_set_style_text_color(\n444\t          lv_obj_get_child(watch->app_list_screen,\n445\t                           app_child_count - 1),\n446\t          ai_watch_theme_secondary(theme), 0);\n447\t    }\n448\t\n449\t  /* Update Settings page */\n450\t\n451\t  lv_obj_set_style_bg_color(watch->settings_screen,\n452\t                            ai_watch_theme_bg(theme), 0);\n453\t\n454\t  settings_child_count =\n455\t      lv_obj_get_child_count(watch->settings_screen);\n456\t\n457\t  for (i = 0; i < settings_child_count; i++)\n458\t    {\n459\t      FAR lv_obj_t *child =\n460\t          lv_obj_get_child(watch->settings_screen, i);\n461\t\n462\t      if (child == watch->about_label)\n463\t        {\n464\t          lv_obj_set_style_text_color(child,\n465\t                                      ai_watch_theme_secondary(theme), 0);\n466\t        }\n467\t      else if (child != watch->bt_switch &&\n468\t               child != watch->theme_roller)\n469\t        {\n470\t          lv_obj_set_style_text_color(child,\n471\t                                      ai_watch_theme_text(theme), 0);\n472\t        }\n473\t    }\n474\t}\n475\t\n476\t/****************************************************************************\n477\t * Private Functions - State Management\n478\t ****************************************************************************/\n479\t\n480\tstatic void ai_watch_update_bt_state(FAR struct ai_watch_s *watch,\n481\t                                     bool new_state)\n482\t{\n483\t  watch->bt_state = new_state;\n484\t  watch->settings_bt_enabled = new_state;\n485\t\n486\t  lv_label_set_text(watch->bt_label,\n487\t                    watch->bt_state ? \"BT: ON\" : \"BT: OFF\");\n488\t\n489\t  if (watch->bt_switch != NULL)\n490\t    {\n491\t      if (watch->bt_state)\n492\t        {\n493\t          lv_obj_add_state(watch->bt_switch, LV_STATE_CHECKED);\n494\t        }\n495\t      else\n496\t        {\n497\t          lv_obj_clear_state(watch->bt_switch, LV_STATE_CHECKED);\n498\t        }\n499\t    }\n500\t\n501\t  printf(\"Bluetooth %s\\n\", watch->bt_state ? \"enabled\" : \"disabled\");\n502\t}\n503\t\n504\t/****************************************************************************\n505\t * Private Functions - Page Management\n506\t ****************************************************************************/\n507\t\n508\tstatic void ai_watch_page_manager_init(FAR struct ai_watch_s *watch)\n509\t{\n510\t  watch->page_stack_top = 0;\n511\t  watch->current_page = AI_WATCH_PAGE_HOME;\n512\t  watch->app_page_screen = NULL;\n513\t  watch->page_stack[0] = AI_WATCH_PAGE_HOME;\n514\t}\n515\t\n516\tstatic void ai_watch_push_page(FAR struct ai_watch_s *watch, int page)\n517\t{\n518\t  FAR lv_obj_t *target = NULL;\n519\t  lv_scr_load_anim_t anim;\n520\t\n521\t  if (watch->page_stack_top >= AI_WATCH_PAGE_STACK_MAX - 1)\n522\t    {\n523\t      printf(\"ERROR: Page stack overflow\\n\");\n524\t      return;\n525\t    }\n526\t\n527\t  if (page < AI_WATCH_PAGE_FIXED_COUNT)\n528\t    {\n529\t      target = watch->fixed_pages[page];\n530\t    }\n531\t  else if (page == AI_WATCH_PAGE_APP_BASE &&\n532\t           watch->app_page_screen != NULL)\n533\t    {\n534\t      target = watch->app_page_screen;\n535\t    }\n536\t\n537\t  if (target == NULL)\n538\t    {\n539\t      return;\n540\t    }\n541\t\n542\t  watch->page_stack_top++;\n543\t  watch->page_stack[watch->page_stack_top] = page;\n544\t  watch->current_page = page;\n545\t\n546\t  anim = (page == AI_WATCH_PAGE_APP_LIST) ?\n547\t         LV_SCR_LOAD_ANIM_MOVE_LEFT :\n548\t         LV_SCR_LOAD_ANIM_MOVE_TOP;\n549\t\n550\t  lv_scr_load_anim(target, anim, 200, 0, false);\n551\t  printf(\"Push page %d (stack depth %d)\\n\", page,\n552\t         watch->page_stack_top);\n553\t}\n554\t\n555\tstatic void ai_watch_pop_page(FAR struct ai_watch_s *watch)\n556\t{\n557\t  int prev_page;\n558\t  FAR lv_obj_t *target;\n559\t  lv_scr_load_anim_t anim;\n560\t\n561\t  if (watch->page_stack_top <= 0)\n562\t    {\n563\t      return;\n564\t    }\n565\t\n566\t  /* Close dynamic app page if we're leaving it */\n567\t\n568\t  if (watch->current_page == AI_WATCH_PAGE_APP_BASE)\n569\t    {\n570\t      ai_watch_close_app(watch);\n571\t    }\n572\t\n573\t  watch->page_stack_top--;\n574\t  prev_page = watch->page_stack[watch->page_stack_top];\n575\t\n576\t  if (prev_page < AI_WATCH_PAGE_FIXED_COUNT)\n577\t    {\n578\t      target = watch->fixed_pages[prev_page];\n579\t    }\n580\t  else\n581\t    {\n582\t      return;\n583\t    }\n584\t\n585\t  if (target == NULL)\n586\t    {\n587\t      return;\n588\t    }\n589\t\n590\t  watch->current_page = prev_page;\n591\t\n592\t  anim = (prev_page == AI_WATCH_PAGE_HOME) ?\n593\t         LV_SCR_LOAD_ANIM_MOVE_RIGHT :\n594\t         LV_SCR_LOAD_ANIM_MOVE_BOTTOM;\n595\t\n596\t  lv_scr_load_anim(target, anim, 200, 0, false);\n597\t  printf(\"Pop to page %d (stack depth %d)\\n\", prev_page,\n598\t         watch->page_stack_top);\n599\t}\n600\t\n601\tstatic void ai_watch_open_app(FAR struct ai_watch_s *watch, int app_index)\n602\t{\n603\t  if (app_index < 0 || app_index >= (int)AI_WATCH_APP_COUNT)\n604\t    {\n605\t      return;\n606\t    }\n607\t\n608\t  const struct ai_app_desc_s *app = &g_app_registry[app_index];\n609\t\n610\t  if (!app->available || app->create_cb == NULL)\n611\t    {\n612\t      FAR lv_obj_t *msgbox = lv_msgbox_create(NULL);\n613\t\n614\t      lv_msgbox_add_title(msgbox, \"Coming Soon\");\n615\t      lv_msgbox_add_text(msgbox, \"This app is under development.\");\n616\t      lv_msgbox_add_close_button(msgbox);\n617\t      return;\n618\t    }\n619\t\n620\t  app->create_cb(watch);\n621\t\n622\t  if (watch->app_page_screen != NULL)\n623\t    {\n624\t      watch->page_stack_top++;\n625\t      watch->page_stack[watch->page_stack_top] =\n626\t          AI_WATCH_PAGE_APP_BASE;\n627\t      watch->current_page = AI_WATCH_PAGE_APP_BASE;\n628\t\n629\t      lv_scr_load_anim(watch->app_page_screen,\n630\t                       LV_SCR_LOAD_ANIM_MOVE_LEFT, 200, 0, false);\n631\t      printf(\"Opened app: %s\\n\", app->name);\n632\t    }\n633\t}\n634\t\n635\tstatic void ai_watch_close_app(FAR struct ai_watch_s *watch)\n636\t{\n637\t  int app_index;\n638\t\n639\t  /* Find the active app and call its destroy callback */\n640\t\n641\t  for (app_index = 0; app_index < (int)AI_WATCH_APP_COUNT; app_index++)\n642\t    {\n643\t      if (g_app_registry[app_index].destroy_cb != NULL &&\n644\t          watch->app_page_screen != NULL)\n645\t        {\n646\t          g_app_registry[app_index].destroy_cb(watch);\n647\t          break;\n648\t        }\n649\t    }\n650\t\n651\t  watch->app_page_screen = NULL;\n652\t}\n653\t\n654\t/****************************************************************************\n655\t * Private Functions - Timer App\n656\t ****************************************************************************/\n657\t\n658\tstatic void ai_watch_timer_update_cb(FAR lv_timer_t *timer)\n659\t{\n660\t  FAR struct ai_watch_s *watch = lv_timer_get_user_data(timer);\n661\t  uint32_t total_ms;\n662\t  uint32_t minutes;\n663\t  uint32_t seconds;\n664\t  uint32_t centiseconds;\n665\t  char buf[16];\n666\t\n667\t  if (watch->timer.running)\n668\t    {\n669\t      total_ms = watch->timer.elapsed_ms +\n670\t                 (lv_tick_get() - watch->timer.start_tick);\n671\t    }\n672\t  else\n673\t    {\n674\t      total_ms = watch->timer.elapsed_ms;\n675\t    }\n676\t\n677\t  minutes = total_ms / 60000;\n678\t  seconds = (total_ms % 60000) / 1000;\n679\t  centiseconds = (total_ms % 1000) / 10;\n680\t\n681\t  snprintf(buf, sizeof(buf), \"%02lu:%02lu.%02lu\",\n682\t           (unsigned long)minutes,\n683\t           (unsigned long)seconds,\n684\t           (unsigned long)centiseconds);\n685\t  lv_label_set_text(watch->timer.time_label, buf);\n686\t}\n687\t\n688\tstatic void ai_watch_timer_start_cb(lv_event_t *e)\n689\t{\n690\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n691\t  FAR lv_obj_t *btn = lv_event_get_target(e);\n692\t  FAR lv_obj_t *label = lv_obj_get_child(btn, 0);\n693\t\n694\t  if (!watch->timer.running)\n695\t    {\n696\t      watch->timer.start_tick = lv_tick_get();\n697\t      watch->timer.running = true;\n698\t      lv_label_set_text(label, LV_SYMBOL_PAUSE \" Pause\");\n699\t    }\n700\t  else\n701\t    {\n702\t      watch->timer.elapsed_ms +=\n703\t          lv_tick_get() - watch->timer.start_tick;\n704\t      watch->timer.running = false;\n705\t      lv_label_set_text(label, LV_SYMBOL_PLAY \" Start\");\n706\t    }\n707\t}\n708\t\n709\tstatic void ai_watch_timer_reset_cb(lv_event_t *e)\n710\t{\n711\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n712\t\n713\t  watch->timer.running = false;\n714\t  watch->timer.elapsed_ms = 0;\n715\t  watch->timer.start_tick = 0;\n716\t  lv_label_set_text(watch->timer.time_label, \"00:00.00\");\n717\t\n718\t  /* Reset start button text */\n719\t\n720\t  FAR lv_obj_t *start_btn =\n721\t      lv_obj_get_child(watch->app_page_screen, 1);\n722\t\n723\t  if (start_btn != NULL)\n724\t    {\n725\t      FAR lv_obj_t *label = lv_obj_get_child(start_btn, 0);\n726\t\n727\t      if (label != NULL)\n728\t        {\n729\t          lv_label_set_text(label, LV_SYMBOL_PLAY \" Start\");\n730\t        }\n731\t    }\n732\t}\n733\t\n734\tstatic void ai_watch_timer_back_cb(lv_event_t *e)\n735\t{\n736\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n737\t\n738\t  ai_watch_pop_page(watch);\n739\t}\n740\t\n741\tstatic void ai_watch_create_timer_app(FAR struct ai_watch_s *watch)\n742\t{\n743\t  FAR lv_obj_t *screen;\n744\t  FAR lv_obj_t *title;\n745\t  FAR lv_obj_t *time_lbl;\n746\t  FAR lv_obj_t *start_btn;\n747\t  FAR lv_obj_t *start_lbl;\n748\t  FAR lv_obj_t *reset_btn;\n749\t  FAR lv_obj_t *reset_lbl;\n750\t  FAR lv_obj_t *back_btn;\n751\t  FAR lv_obj_t *back_lbl;\n752\t\n753\t  int theme = watch->current_theme;\n754\t\n755\t  screen = lv_obj_create(NULL);\n756\t  lv_obj_set_style_bg_color(screen, ai_watch_theme_bg(theme), 0);\n757\t  lv_obj_set_scrollbar_mode(screen, LV_SCROLLBAR_MODE_OFF);\n758\t\n759\t  /* Title */\n760\t\n761\t  title = lv_label_create(screen);\n762\t  lv_label_set_text(title, \"Timer\");\n763\t  lv_obj_set_style_text_color(title, ai_watch_theme_text(theme), 0);\n764\t  lv_obj_set_style_text_font(title, &lv_font_montserrat_24, 0);\n765\t  lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 30);\n766\t\n767\t  /* Time display */\n768\t\n769\t  time_lbl = lv_label_create(screen);\n770\t  lv_label_set_text(time_lbl, \"00:00.00\");\n771\t  lv_obj_set_style_text_color(time_lbl, ai_watch_theme_text(theme), 0);\n772\t  lv_obj_set_style_text_font(time_lbl, &lv_font_montserrat_48, 0);\n773\t  lv_obj_align(time_lbl, LV_ALIGN_CENTER, 0, -50);\n774\t  watch->timer.time_label = time_lbl;\n775\t\n776\t  /* Start/Pause button */\n777\t\n778\t  start_btn = lv_btn_create(screen);\n779\t  lv_obj_set_size(start_btn, 120, 45);\n780\t  lv_obj_set_style_bg_color(start_btn, ai_watch_theme_accent(theme), 0);\n781\t  lv_obj_set_style_radius(start_btn, 12, 0);\n782\t  lv_obj_align(start_btn, LV_ALIGN_CENTER, -70, 40);\n783\t  start_lbl = lv_label_create(start_btn);\n784\t  lv_label_set_text(start_lbl, LV_SYMBOL_PLAY \" Start\");\n785\t  lv_obj_set_style_text_color(start_lbl, lv_color_white(), 0);\n786\t  lv_obj_set_style_text_font(start_lbl, &lv_font_montserrat_16, 0);\n787\t  lv_obj_center(start_lbl);\n788\t  lv_obj_add_event_cb(start_btn, ai_watch_timer_start_cb,\n789\t                      LV_EVENT_CLICKED, watch);\n790\t\n791\t  /* Reset button */\n792\t\n793\t  reset_btn = lv_btn_create(screen);\n794\t  lv_obj_set_size(reset_btn, 120, 45);\n795\t  lv_obj_set_style_bg_color(reset_btn,\n796\t                            ai_watch_theme_btn_bg(theme), 0);\n797\t  lv_obj_set_style_radius(reset_btn, 12, 0);\n798\t  lv_obj_align(reset_btn, LV_ALIGN_CENTER, 70, 40);\n799\t  reset_lbl = lv_label_create(reset_btn);\n800\t  lv_label_set_text(reset_lbl, LV_SYMBOL_REFRESH \" Reset\");\n801\t  lv_obj_set_style_text_color(reset_lbl, ai_watch_theme_text(theme), 0);\n802\t  lv_obj_set_style_text_font(reset_lbl, &lv_font_montserrat_16, 0);\n803\t  lv_obj_center(reset_lbl);\n804\t  lv_obj_add_event_cb(reset_btn, ai_watch_timer_reset_cb,\n805\t                      LV_EVENT_CLICKED, watch);\n806\t\n807\t  /* Back button */\n808\t\n809\t  back_btn = lv_btn_create(screen);\n810\t  lv_obj_set_size(back_btn, 120, 45);\n811\t  lv_obj_set_style_bg_color(back_btn, ai_watch_theme_btn_bg(theme), 0);\n812\t  lv_obj_set_style_radius(back_btn, 12, 0);\n813\t  lv_obj_align(back_btn, LV_ALIGN_CENTER, 0, 110);\n814\t  back_lbl = lv_label_create(back_btn);\n815\t  lv_label_set_text(back_lbl, LV_SYMBOL_LEFT \" Back\");\n816\t  lv_obj_set_style_text_color(back_lbl, ai_watch_theme_secondary(theme), 0);\n817\t  lv_obj_set_style_text_font(back_lbl, &lv_font_montserrat_16, 0);\n818\t  lv_obj_center(back_lbl);\n819\t  lv_obj_add_event_cb(back_btn, ai_watch_timer_back_cb,\n820\t                      LV_EVENT_CLICKED, watch);\n821\t\n822\t  /* Reset timer state */\n823\t\n824\t  watch->timer.running = false;\n825\t  watch->timer.elapsed_ms = 0;\n826\t  watch->timer.start_tick = 0;\n827\t\n828\t  /* Start display update timer */\n829\t\n830\t  watch->timer.update_timer = lv_timer_create(\n831\t      ai_watch_timer_update_cb, AI_WATCH_TIMER_UPDATE_MS, watch);\n832\t\n833\t  watch->app_page_screen = screen;\n834\t}\n835\t\n836\tstatic void ai_watch_destroy_timer_app(FAR struct ai_watch_s *watch)\n837\t{\n838\t  if (watch->timer.update_timer != NULL)\n839\t    {\n840\t      lv_timer_del(watch->timer.update_timer);\n841\t      watch->timer.update_timer = NULL;\n842\t    }\n843\t\n844\t  watch->timer.running = false;\n845\t  watch->timer.elapsed_ms = 0;\n846\t  watch->timer.start_tick = 0;\n847\t  watch->timer.time_label = NULL;\n848\t\n849\t  if (watch->app_page_screen != NULL)\n850\t    {\n851\t      lv_obj_del(watch->app_page_screen);\n852\t      watch->app_page_screen = NULL;\n853\t    }\n854\t}\n855\t\n856\t/****************************************************************************\n857\t * Private Functions - UI Callbacks\n858\t ****************************************************************************/\n859\t\n860\tstatic void ai_watch_app_icon_cb(lv_event_t *e)\n861\t{\n862\t  FAR lv_obj_t *icon = lv_event_get_target(e);\n863\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n864\t  int index = (int)(intptr_t)lv_obj_get_user_data(icon);\n865\t\n866\t  ai_watch_open_app(watch, index);\n867\t}\n868