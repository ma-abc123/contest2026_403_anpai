n = (lcd_drv_desc_t *)&LcdDriverDescTab_start;\n150\t    table_end = (lcd_drv_desc_t *) &LcdDriverDescTab_end;\n151\t#endif /* defined(__CC_ARM) */\n152\t\n153\t    if ((NULL == table_begin) || (NULL == table_end) || (table_begin == table_end))\n154\t    {\n155\t        lcdwarn(\"No LCD driver registered!\");\n156\t        return NULL;\n157\t\n158\t    }\n159\t\n160\t#ifndef LCD_MISSING\n161\t    for (p_drv_desc = table_begin; p_drv_desc < table_end; p_drv_desc++)\n162\t    {\n163\t        if ((p_drv_desc->p_ops != NULL) && (p_drv_desc->p_init_cfg != NULL))\n164\t        {\n165\t            if (p_drv_desc->p_ops->ReadID != NULL)\n166\t            {\n167\t                uint32_t id;\n168\t\n169\t                if (p_drv_desc->p_ops->Init != NULL)\n170\t                    p_drv_desc->p_ops->Init(&s_drv_lcd.hlcdc);\n171\t\n172\t                id = p_drv_desc->p_ops->ReadID(&s_drv_lcd.hlcdc);\n173\t\n174\t                if (p_drv_desc->id == id)\n175\t                {\n176\t                    lcdinfo(\"Found lcd %s id:%lxh\", p_drv_desc->name, id);\n177\t                    return p_drv_desc;\n178\t                }\n179\t                else\n180\t                {\n181\t                    lcdinfo(\"Try lcd %s, read id:%lxh, expect:%lxh\", p_drv_desc->name, id, p_drv_desc->id);\n182\t                }\n183\t            }\n184\t        }\n185\t    }\n186\t#endif\n187\t    lcdwarn(\"unknow lcd!\");\n188\t    return NULL;\n189\t}\n190\t\n191\tstatic void sf32lb_lcd_setarea(FAR struct sf32lb_lcd_dev_s *dev,\n192\t                           uint16_t x0, uint16_t y0,\n193\t                           uint16_t x1, uint16_t y1)\n194\t{\n195\t\tif (dev && dev->p_drv_ops && dev->p_drv_ops->p_ops \n196\t\t\t   && dev->p_drv_ops->p_ops->SetRegion)\n197\t    {\n198\t        int new_x0, new_x1, new_y0, new_y1;\n199\t\n200\t\n201\t        //disable_low_power(&drv_lcd);\n202\t\n203\t        lcd_debug_print(\"set_window [%d,%d,%d,%d]\", x0, y0, x1, y1);\n204\t        new_x0 = x0;\n205\t        new_x1 = x1;\n206\t        new_y0 = y0;\n207\t        new_y1 = y1;\n208\t\n209\t\n210\t        DEBUGASSERT((new_x0 <= new_x1) && (new_y0 <= new_y1));\n211\t        DEBUGASSERT((new_x1 - new_x0 + 1) <= dev->p_drv_ops->lcd_horizonal_res);\n212\t        DEBUGASSERT((new_y1 - new_y0 + 1) <= dev->p_drv_ops->lcd_vertical_res);\n213\t\n214\t        dev->p_drv_ops->p_ops->SetRegion(&dev->hlcdc, new_x0, new_y0, new_x1, new_y1);\n215\t        //enable_low_power(&drv_lcd);\n216\t\n217\t    }\n218\t}\n219\tstatic void SendLayerDataCpltCbk(LCDC_HandleTypeDef *lcdc)\n220\t{\n221\t\n222\t   //lcdinfo(\"SendLayerDataCpltCbk \\r\\n\");\n223\t\n224\t   if (lcdc->XferCpltCallback != NULL)\n225\t   {\n226\t       lcdc->XferCpltCallback = NULL;\n227\t\n228\t\n229\t       struct sf32lb_lcd_dev_s *p_drvlcd = container_of(lcdc, struct sf32lb_lcd_dev_s, hlcdc);\n230\t       sem_post(&p_drvlcd->draw_sem);\n231\t   }\n232\t\n233\t}\n234\t\n235\tstatic void SendLayerDataErrCbk(LCDC_HandleTypeDef *lcdc)\n236\t{\n237\t    lcdinfo(\"SendLayerDataErrCbk \\r\\n\");\n238\t}\n239\t\n240\t\n241\tstatic void sf32lb_lcd_wrram(FAR struct sf32lb_lcd_dev_s *dev, FAR const uint8_t *buffer,\n242\t                          uint16_t x0, uint16_t y0,\n243\t                          uint16_t x1, uint16_t y1)\n244\t{\n245\t   if (dev && dev->p_drv_ops && dev->p_drv_ops->p_ops \n246\t   \t\t  && dev->p_drv_ops->p_ops->WriteMultiplePixels)\n247\t   {\n248\t       uint16_t new_x0, new_x1, new_y0, new_y1;\n249\t  size_t pixels;\n250\t  size_t xfer_bytes;\n251\t\n252\t       DEBUGASSERT((x0 <= x1) && (y0 <= y1));\n253\t\n254\t       //disable_low_power(&drv_lcd);\n255\t\n256\t       lcd_debug_print(\"sf32lb_lcd_wrram [%d,%d,%d,%d]\", x0, y0, x1, y1);\n257\t       new_x0 = x0;\n258\t       new_x1 = x1;\n259\t       new_y0 = y0;\n260\t       new_y1 = y1;\n261\t\n262\t\n263\t       DEBUGASSERT((new_x0 <= new_x1) && (new_y0 <= new_y1));\n264\t       DEBUGASSERT((new_x1 - new_x0 + 1) <= dev->p_drv_ops->lcd_horizonal_res);\n265\t       DEBUGASSERT((new_y1 - new_y0 + 1) <= dev->p_drv_ops->lcd_vertical_res);\n266\t\n267\t        /* Ensure DMA reads the latest pixel data from memory. */\n268\t\n269\t        pixels = (size_t)(new_x1 - new_x0 + 1) * (size_t)(new_y1 - new_y0 + 1);\n270\t        xfer_bytes = pixels * ((size_t)dev->bpp >> 3);\n271\t        if (buffer != NULL && xfer_bytes > 0)\n272\t        {\n273\t          up_clean_dcache((uintptr_t)buffer, (uintptr_t)buffer + xfer_bytes);\n274\t        }\n275\t       \n276\t        /* Drain stale completion tokens before starting a new transfer. */\n277\t        while (sem_trywait(&(dev->draw_sem)) == 0)\n278\t        {\n279\t        }\n280\t\n281\t        dev->hlcdc.XferCpltCallback = SendLayerDataCpltCbk;\n282\t        dev->hlcdc.XferErrorCallback = SendLayerDataErrCbk;\n283\t        dev->hlcdc.debug_cnt0++;\n284\t\n285\t\n286\t        dev->p_drv_ops->p_ops->WriteMultiplePixels(&dev->hlcdc, buffer, new_x0, new_y0, new_x1, new_y1);\n287\t        //enable_low_power(&drv_lcd);\n288\t        /* --------- Wait send complete (bounded wait) -----------------*/\n289\t        {\n290\t          struct timespec ts;\n291\t          clock_gettime(CLOCK_REALTIME, &ts);\n292\t          ts.tv_nsec += 200 * 1000 * 1000; /* 200ms */\n293\t          if (ts.tv_nsec >= 1000000000L)\n294\t          {\n295\t            ts.tv_sec += 1;\n296\t            ts.tv_nsec -= 1000000000L;\n297\t          }\n298\t\n299\t          if (sem_timedwait(&(dev->draw_sem), &ts) < 0)\n300\t          {\n301\t            lcdwarn(\"lcd xfer wait timeout: %d\", errno);\n302\t          }\n303\t        }\n304\t\n305\t   }\n306\t}\n307\t\n308\t\n309\t                           \n310\t\n311\t/****************************************************************************\n312\t * Name:  sf32lb_lcd_putrun\n313\t *\n314\t * Description:\n315\t *   This method can be used to write a partial raster line to the LCD:\n316\t *\n317\t *   dev     - The lcd device\n318\t *   row     - Starting row to write to (range: 0 <= row < yres)\n319\t *   col     - Starting column to write to (range: 0 <= col <= xres-npixels)\n320\t *   buffer  - The buffer containing the run to be written to the LCD\n321\t *   npixels - The number of pixels to write to the LCD\n322\t *             (range: 0 < npixels <= xres-col)\n323\t *\n324\t ****************************************************************************/\n325\t\n326\tstatic int sf32lb_lcd_putrun(FAR struct lcd_dev_s *dev,\n327\t                         fb_coord_t row, fb_coord_t col,\n328\t                         FAR const uint8_t *buffer, size_t npixels)\n329\t{\n330\t  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;\n331\t\n332\t  if (s_fb_registering || !s_lcd_hw_ready)\n333\t    {\n334\t      return OK;\n335\t    }\n336\t\n337\t  lcd_debug_print(\"row: %d col: %d npixels: %d\\n\", row, col, npixels);\n338\t  DEBUGASSERT(buffer && ((uintptr_t)buffer & 1) == 0);\n339\t\n340\t  if (priv->bpp == 8)\n341\t    {\n342\t      FAR uint16_t *conv;\n343\t      size_t i;\n344\t\n345\t      conv = kmm_malloc(npixels * sizeof(uint16_t));\n346\t      if (conv == NULL)\n347\t        {\n348\t          return -ENOMEM;\n349\t        }\n350\t\n351\t      for (i = 0; i < npixels; i++)\n352\t        {\n353\t          uint8_t v = buffer[i];\n354\t          uint8_t r = (v >> 5) & 0x07;\n355\t          uint8_t g = (v >> 2) & 0x07;\n356\t          uint8_t b = v & 0x03;\n357\t\n358\t          conv[i] = (uint16_t)((((uint16_t)r * 31 / 7) << 11) |\n359\t                               (((uint16_t)g * 63 / 7) << 5) |\n360\t                               (((uint16_t)b * 31 / 3) << 0));\n361\t        }\n362\t\n363\t      sf32lb_lcd_setarea(priv, col, row, col + npixels - 1, row);\n364\t      sf32lb_lcd_wrram(priv, (FAR const uint8_t *)conv,\n365\t                       col, row, col + npixels - 1, row);\n366\t      sf32lb_lcd_ensure_display_on(priv);\n367\t      kmm_free(conv);\n368\t      return OK;\n369\t    }\n370\t\n371\t  sf32lb_lcd_setarea(priv, col, row, col + npixels - 1, row);\n372\t  sf32lb_lcd_wrram(priv, buffer, col, row, col + npixels - 1, row);\n373\t  sf32lb_lcd_ensure_display_on(priv);\n374\t\n375\t  return OK;\n376\t}\n377\t\n378\t/****************************************************************************\n379\t * Name:  sf32lb_lcd_putarea\n380\t *\n381\t * Description:\n382\t *   This method can be used to write a partial area to the LCD:\n383\t *\n384\t *   dev       - The lcd device\n385\t *   row_start - Starting row to write to (range: 0 <= row < yres)\n386\t *   row_end   - Ending row to write to (range: row_start <= row < yres)\n387\t *   col_start - Starting column to write to (range: 0 <= col <= xres)\n388\t *   col_end   - Ending column to write to\n389\t *               (range: col_start <= col_end < xres)\n390\t *   buffer    - The buffer containing the area to be written to the LCD\n391\t *   stride    - Length of a line in bytes. This parameter may be necessary\n392\t *               to allow the LCD driver to calculate the offset for partial\n393\t *               writes when the buffer needs to be splited for row-by-row\n394\t *               writing.\n395\t *\n396\t ****************************************************************************/\n397\t\n398\tstatic int sf32lb_lcd_putarea(FAR struct lcd_dev_s *dev,\n399\t                          fb_coord_t row_start, fb_coord_t row_end,\n400\t                          fb_coord_t col_start, fb_coord_t col_end,\n401\t                          FAR const uint8_t *buffer, fb_coord_t stride)\n402\t{\n403\t  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;\n404\t  size_t bytes_per_pixel;\n405\t  size_t row_bytes;\n406\t\n407\t  if (s_fb_registering || !s_lcd_hw_ready)\n408\t    {\n409\t      return OK;\n410\t    }\n411\t\n412\t  bytes_per_pixel = priv->bpp >> 3;\n413\t  row_bytes = (size_t)(col_end - col_start + 1) * bytes_per_pixel;\n414\t\n415\t  lcd_debug_print(\"row_start: %d row_end: %d col_start: %d col_end: %d\\n\",\n416\t         row_start, row_end, col_start, col_end);\n417\t\n418\t  DEBUGASSERT(buffer && ((uintptr_t)buffer & 1) == 0);\n419\t\n420\t  if (priv->bpp == 8)\n421\t    {\n422\t      fb_coord_t y;\n423\t      fb_coord_t width = col_end - col_start + 1;\n424\t      FAR uint16_t *conv = kmm_malloc(width * sizeof(uint16_t));\n425\t\n426\t      if (conv == NULL)\n427\t        {\n428\t          return -ENOMEM;\n429\t        }\n430\t\n431\t      for (y = row_start; y <= row_end; y++)\n432\t        {\n433\t          FAR const uint8_t *src = buffer + (y - row_start) * stride;\n434\t          fb_coord_t x;\n435\t\n436\t          for (x = 0; x < width; x++)\n437\t            {\n438\t              uint8_t v = src[x];\n439\t              uint8_t r = (v >> 5) & 0x07;\n440\t              uint8_t g = (v >> 2) & 0x07;\n441\t              uint8_t b = v & 0x03;\n442\t\n443\t              conv[x] = (uint16_t)((((uint16_t)r * 31 / 7) << 11) |\n444\t                                   (((uint16_t)g * 63 / 7) << 5) |\n445\t                                   (((uint16_t)b * 31 / 3) << 0));\n446\t            }\n447\t\n448\t          sf32lb_lcd_setarea(priv, col_start, y, col_end, y);\n449\t          sf32lb_lcd_wrram(priv, (FAR const uint8_t *)conv,\n450\t                           col_start, y, col_end, y);\n451\t        }\n452\t\n453\t      sf32lb_lcd_ensure_display_on(priv);\n454\t      kmm_free(conv);\n455\t      return OK;\n456\t    }\n457\t\n458\t  if ((size_t)stride == row_bytes)\n459\t    {\n460\t      fb_coord_t y = row_start;\n461\t      const fb_coord_t chunk_rows = 24;\n462\t\n463\t      while (y <= row_end)\n464\t        {\n465\t          fb_coord_t y1 = y + chunk_rows - 1;\n466\t          FAR const uint8_t *src;\n467\t\n468\t          if (y1 > row_end)\n469\t            {\n470\t              y1 = row_end;\n471\t            }\n472\t\n473\t          src = buffer + (y - row_start) * stride;\n474\t          sf32lb_lcd_setarea(priv, col_start, y, col_end, y1);\n475\t          sf32lb_lcd_wrram(priv, src, col_start, y, col_end, y1);\n476\t          y = y1 + 1;\n477\t        }\n478\t    }\n479\t  else\n480\t    {\n481\t      fb_coord_t y;\n482\t\n483\t      /* The source rows are not tightly packed for this area, so send\n484\t       * one row at a time using stride to step through the source buffer.\n485\t       */\n486\t\n487\t      for (y = row_start; y <= row_end; y++)\n488\t        {\n489\t          FAR const uint8_t *src = buffer + (y - row_start) * stride;\n490\t\n491\t          sf32lb_lcd_setarea(priv, col_start, y, col_end, y);\n492\t          sf32lb_lcd_wrram(priv, src, col_start, y, col_end, y);\n493\t        }\n494\t    }\n495\t\n496\t  sf32lb_lcd_ensure_display_on(priv);\n497\t\n498\t  return OK;\n499\t}\n500\t\n501\t/****************************************************************************\n502\t * Name:  sf32lb_lcd_getrun\n503\t *\n504\t * Description:\n505\t *   This method can be used to read a partial raster line from the LCD:\n506\t *\n507\t *  dev     - The lcd device\n508\t *  row     - Starting row to read from (range: 0 <= row < yres)\n509\t *  col     - Starting column to read read (range: 0 <= col <= xres-npixels)\n510\t *  buffer  - The buffer in which to return the run read from the LCD\n511\t *  npixels - The number of pixels to read from the LCD\n512\t *            (range: 0 < npixels <= xres-col)\n513\t *\n514\t ****************************************************************************/\n515\t\n516\t#ifndef CONFIG_LCD_NOGETRUN\n517\tstatic int sf32lb_lcd_getrun(FAR struct lcd_dev_s *dev,\n518\t                         fb_coord_t row, fb_coord_t col,\n519\t                         FAR uint8_t *buffer, size_t npixels)\n520\t{\n521\t  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;\n522\t  //FAR uint16_t *dest = (FAR uint16_t *)buffer;\n523\t\n524\t  lcdinfo(\"row: %d col: %d npixels: %d\\n\", row, col, npixels);\n525\t  DEBUGASSERT(buffer && ((uintptr_t)buffer & 1) == 0);\n526\t\n527\t  sf32lb_lcd_setarea(priv, col, row, col + npixels - 1, row);\n528\t  //sf32lb_lcd_rdram(priv, dest, npixels);\n529\t  DEBUGASSERT(0);\n530\t  return OK;\n531\t}\n532\t#endif\n533\t\n534\t/****************************************************************************\n535\t * Name:  sf32lb_lcd_getvideoinfo\n536\t *\n537\t * Description:\n538\t *   Get information about the LCD video controller configuration.\n539\t *\n540\t ****************************************************************************/\n541\t\n542\tstatic int sf32lb_lcd_getvideoinfo(FAR struct lcd_dev_s *dev,\n543\t                               FAR struct fb_videoinfo_s *vinfo)\n544\t{\n545\t  DEBUGASSERT(dev && vinfo);\n546\t\n547\t  /* Wait for async lcd_init task to finish before accessing driver state */\n548\t\n549\t  if(!s_drv_lcd.p_drv_ops)\n550\t  {\n551\t  \tsem_wait(&(s_drv_lcd.init_sem));\n552\t\tsem_post(&s_drv_lcd.init_sem);\n553\t  }\n554\t\n555\t switch(s_drv_lcd.bpp)\n556\t {\n557\t    case 8:\n558\t      vinfo->fmt     = FB_FMT_RGB8_332;\n559\t      break;\n560\t\n561\t    case 16:\n562\t      vinfo->fmt     = FB_FMT_RGB16_565;    /* Color format: RGB16-565: RRRR RGGG GGGB BBBB */\n563\t      break;\n564\t\n565\t    case 24:\n566\t      vinfo->fmt     = FB_FMT_RGB24;    /* Color format: RGB24 */\n567\t      break;\n568\t\n569\t    default:\n570\t        DEBUGASSERT(0);\n571\t        break;\n572\t  }\n573\t\n574\t  vinfo->xres    = s_drv_lcd.p_drv_ops->lcd_horizonal_res;        /* Horizontal resolution in pixel columns */\n575\t  vinfo->yres    = s_drv_lcd.p_drv_ops->lcd_vertical_res;        /* Vertical resolution in pixel rows */\n576\t  vinfo->nplanes = 1;                  /* Number of color planes supported */\n577\t\n578\t  \n579\t  lcdinfo(\"fmt: %d xres: %d yres: %d nplanes: 1\\n\",\n580\t          vinfo->fmt, vinfo->xres, vinfo->yres);\n581\t  return OK;\n582\t}\n583\t\n584\t/****************************************************************************\n585\t * Name:  sf32lb_lcd_getplaneinfo\n586\t *\n587\t * Description:\n588\t *   Get information about the configuration of each LCD color plane.\n589\t *\n590\t ****************************************************************************/\n591\t\n592\tstatic int sf32lb_lcd_getplaneinfo(FAR struct lcd_dev_s *dev,\n593\t                               unsigned int planeno,\n594\t                               FAR struct lcd_planeinfo_s *pinfo)\n595\t{\n596\t  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;\n597\t\n598\t  if(!s_drv_lcd.p_drv_ops)\n599\t  {\n600\t  \tsem_wait(&(s_drv_lcd.init_sem));\n601\t\tsem_post(&s_drv_lcd.init_sem);\n602\t  }\n603\t\n604\t  DEBUGASSERT(dev && pinfo && planeno == 0);\n605\t  lcdinfo(\"planeno: %d bpp: %d\\n\", planeno, priv->bpp);\n606\t\n607\t  pinfo->putrun = sf32lb_lcd_putrun;                  /* Put a run into LCD memory */\n608\t  pinfo->putarea = sf32lb_lcd_putarea;                /* Put an area into LCD */\n609\t#ifndef CONFIG_LCD_NOGETRUN\n610\t  pinfo->getrun = sf32lb_lcd_getrun;                  /* Get a run from LCD memory */\n611\t#endif\n612\t  pinfo->buffer = NULL; //(FAR uint8_t *)priv->runbuffer; /* Run scratch buffer */\n613\t  pinfo->bpp    = priv->bpp;                      /* Bits-per-pixel */\n614\t  pinfo->dev    = dev;                            /* The lcd device */\n615\t  return OK;\n616\t}\n617\t\n618\t/****************************************************************************\n619\t * Name:  sf32lb_lcd_getpower\n620\t ****************************************************************************/\n621\t\n622\tstatic int sf32lb_lcd_getpower(FAR struct lcd_dev_s *dev)\n623\t{\n624\t  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;\n625\t\n626\t  lcdinfo(\"power: %d\\n\", priv->power);\n627\t  return priv->power;\n628\t}\n629\t\n630\t/****************************************************************************\n631\t * Name:  sf32lb_lcd_setpower\n632\t ****************************************************************************/\n633\t\n634\tstatic int sf32lb_lcd_setpower(FAR struct lcd_dev_s *dev, int power)\n635\t{\n636\t  FAR struct sf32lb_lcd_dev_s *priv = (FAR struct sf32lb_lcd_dev_s *)dev;\n637\t\n638\t  lcdinfo(\"power: %d\\n\", power);\n639\t  DEBUGASSERT((unsigned)power <= CONFIG_LCD_MAXPOWER);\n640\t\n641\t  /* Set new power level */\n642\t\n643\t  if (power > 0)\n644\t    {\n645\t      /* Turn on the display */\n646\t\n647\t      if (priv->p_drv_ops && priv->p_drv_ops->p_ops &&\n648\t          priv->p_drv_ops->p_ops->DisplayOn)\n649\t        {\n650\t          priv->p_drv_ops->p_ops->DisplayOn(&priv->hlcdc);\n651\t        }\n652\t\n653\t      /* Save the power */\n654\t\n655\t      priv->power = power;\n656\t    }\n657\t  else\n658\t    {\n659\t      /* Turn off the display */\n660\t\n661\t      if (priv->p_drv_ops && priv->p_drv_ops->p_ops &&\n662\t          priv->p_drv_ops->p_ops->DisplayOff)\n663\t        {\n664\t          priv->p_drv_ops->p_ops->DisplayOff(&priv->hlcdc);\n665\t        }\n666\t\n667\t      /* Save the power */\n668\t\n669\t      priv->power = 0;\n670\t    }\n671\t\n672\t  return OK;\n673\t}\n674\t\n675\t/****************************************************************************\n676\t * Name:  sf32lb_lcd_getcontrast\n677\t *\n678\t * Description:\n679\t *   Get the current contrast setting (0-CONFIG_LCD_MAXCONTRAST).\n680\t *\n681\t ****************************************************************************/\n682\t\n683\tstatic int sf32lb_lcd_getcontrast(FAR struct lcd_dev_s *dev)\n684\t{\n685\t  lcdinfo(\"Not implemented\\n\");\n686\t  return -ENOSYS;\n687\t}\n688\t\n689\t/****************************************************************************\n690\t * Name:  sf32lb_lcd_setcontrast\n691\t *\n692\t * Description:\n693\t *   Set LCD panel contrast (0-CONFIG_LCD_MAXCONTRAST).\n694\t *\n695\t ***************************************************************************