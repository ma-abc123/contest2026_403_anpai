2:\n        return (255, 255, 255, 255)\n    # Clock hands\n    if dist < r:\n        # Hour hand (pointing to 10 o'clock)\n        if abs(x - cx) <= 1 and cy - 10 <= y <= cy:\n            return (255, 255, 255, 255)\n        # Minute hand (pointing to 2)\n        if abs(y - cy + 4) <= 1 and cx <= x <= cx + 10:\n            return (255, 255, 255, 255)\n        # Center dot\n        if dist <= 2:\n            return (255, 255, 255, 255)\n        return bg\n    # Top button\n    if abs(x - cx) <= 2 and cy - r - 4 <= y <= cy - r:\n        return (255, 255, 255, 255)\n    return (0, 0, 0, 0)\n\ndef icon_reminder(x, y, w, h, bg):\n    cx, cy = w//2, h//2\n    r = min(w, h) // 2 - 1\n    dx, dy = x - cx, y - cy\n    dist = (dx*dx + dy*dy) ** 0.5\n    if dist <= r:\n        # Bell body\n        bell_top = cy - 10\n        bell_bot = cy + 6\n        if bell_top <= y <= bell_bot:\n            width_at_y = int(8 * (y - bell_top) / (bell_bot - bell_top)) + 4\n            if abs(x - cx) <= width_at_y:\n                return (255, 255, 255, 255)\n        # Bell top handle\n        if abs(x - cx) <= 2 and cy - 14 <= y <= bell_top:\n            return (255, 255, 255, 255)\n        # Clapper\n        if abs(x - cx) <= 3 and cy + 6 <= y <= cy + 10:\n            return (255, 255, 255, 255)\n        return bg\n    return (0, 0, 0, 0)\n\ndef icon_settings(x, y, w, h, bg):\n    cx, cy = w//2, h//2\n    r = min(w, h) // 2 - 1\n    dx, dy = x - cx, y - cy\n    dist = (dx*dx + dy*dy) ** 0.5\n    if dist <= r:\n        # Gear - outer ring with teeth\n        inner_r = 8\n        outer_r = 14\n        if inner_r <= dist <= outer_r:\n            angle = (x - cx, y - cy)\n            import math\n            ang = math.atan2(dy, dx)\n            ang_deg = (math.degrees(ang) + 360) % 360\n            # Teeth every 60 degrees, 15 degrees wide\n            tooth = False\n            for t in range(0, 360, 60):\n                if abs((ang_deg - t + 180) % 360 - 180) < 15:\n                    tooth = True\n                    break\n            if tooth or dist <= inner_r + 2:\n                return (255, 255, 255, 255)\n        # Center hole\n        if dist <= 4:\n            return bg\n        return bg\n    return (0, 0, 0, 0)\n\nW, H = 40, 40\nbg = (40, 40, 40, 255)\n\nicons = [\n    ('exercise', bg, icon_exercise),\n    ('timer', bg, icon_timer),\n    ('reminder', bg, icon_reminder),\n    ('settings', bg, icon_settings),\n]\n\nfor name, bgc, func in icons:\n    data = create_icon(W, H, bgc, func)\n    # Output as C hex array\n    print(f'static const uint8_t icon_{name}_data[] = {{')\n    line = '    '\n    for i, byte in enumerate(data):\n        line += f'0x{byte:02x},'\n        if (i + 1) % 16 == 0:\n            print(line)\n            line = '    '\n    if line.strip():\n        print(line)\n    print('};')\n    print()\n\" 2>&1 | head -20", "description": "Generate icon pixel data", "timeout": 30000}, "output": null}
