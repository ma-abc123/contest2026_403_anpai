angle_rad = (float)idx2 * (float)M_PI / 6.0f;\n420\t      *out_x = r * cosf(angle_rad);\n421\t      *out_y = r * sinf(angle_rad);\n422\t    }\n423\t}\n424\t\n425\t/****************************************************************************\n426\t * Private Functions - Hex Menu: Transform & Rendering\n427\t *\n428\t * Performance notes:\n429\t *   - Uses distance-squared (no sqrtf) for scale/opacity tiers.\n430\t *   - Caches last-applied (x, y, zoom, opa, hidden) per icon and skips\n431\t *     LVGL calls when nothing changed.\n432\t *   - Drag threshold: ignores tiny moves (<3 px) to avoid re-render.\n433\t ****************************************************************************/\n434\t\n435\t/* Distance-squared thresholds for scale/opacity tiers.\n436\t * Using squared values avoids sqrtf in the hot path.\n437\t * Thresholds are in pixels-squared.\n438\t */\n439\t\n440\t#define MENU_D2_TIER1  (100.0f * 100.0f)   /* ~100 px from center */\n441\t#define MENU_D2_TIER2  (200.0f * 200.0f)   /* ~200 px from center */\n442\t#define MENU_D2_TIER3  (350.0f * 350.0f)   /* ~350 px from center */\n443\t\n444\tstatic void ai_menu_update_transform(FAR struct ai_watch_s *watch)\n445\t{\n446\t  FAR struct ai_menu_ctx_s *ctx = &watch->menu;\n447\t  float scr_cx = (float)AI_WATCH_SCREEN_WIDTH / 2.0f;\n448\t  float scr_cy = (float)AI_WATCH_SCREEN_HEIGHT / 2.0f;\n449\t  int new_focused;\n450\t  int i;\n451\t\n452\t  new_focused = ai_menu_find_nearest(watch);\n453\t\n454\t  for (i = 0; i < ctx->icon_count; i++)\n455\t    {\n456\t      FAR struct ai_menu_icon_s *icon = &ctx->icons[i];\n457\t      float screen_x;\n458\t      float screen_y;\n459\t      float dx;\n460\t      float dy;\n461\t      float d2;\n462\t      int scale;\n463\t      lv_opa_t opa;\n464\t      bool hidden;\n465\t      int ix;\n466\t      int iy;\n467\t\n468\t      if (icon->img_obj == NULL)\n469\t        {\n470\t          continue;\n471\t        }\n472\t\n473\t      /* Icon position on screen = base - scroll +