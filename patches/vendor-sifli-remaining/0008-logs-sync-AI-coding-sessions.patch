t        }\n595\t    }\n596\t\n597\t  return nearest;\n598\t}\n599\t\n600\t/****************************************************************************\n601\t * Private Functions - Hex Menu: Snap Animation\n602\t *\n603\t * The exec callback updates the scroll value and refreshes the icon\n604\t * transform each frame, so we don't need LV_EVENT_DRAW_POST.\n605\t ****************************************************************************/\n606\t\n607\tstatic void ai_menu_snap_exec_x_cb(void *var, int32_t value)\n608\t{\n609\t  FAR float *target = (FAR float *)var;\n610\t\n611\t  *target = (float)value;\n612\t}\n613\t\n614\tstatic void ai_menu_snap_exec_y_cb(void *var, int32_t value)\n615\t{\n616\t  FAR float *target = (FAR float *)var;\n617\t  FAR lv_anim_t *a;\n618\t  FAR struct ai_watch_s *watch;\n619\t\n620\t  *target = (float)value;\n621\t\n622\t  /* Only refresh transform on the Y animation to avoid double-update.\n623\t   * Both X and Y animations run in parallel; updating once per frame\n624\t   * on the Y callback is sufficient.\n625\t   */\n626\t\n627\t  a = lv_anim_get(var, ai_menu_snap_exec_y_cb);\n628\t  if (a != NULL)\n629\t    {\n630\t      watch = lv_anim_get_user_data(a);\n631\t      if (watch != NULL)\n632\t        {\n633\t          ai_menu_update_transform(watch);\n634\t        }\n635\t    }\n636\t}\n637\t\n638\tstatic void ai_menu_snap_ready_cb(lv_anim_t *a)\n639\t{\n640\t  FAR struct ai_watch_s *watch = lv_anim_get_user_data(a);\n641\t\n642\t  if (watch != NULL)\n643\t    {\n644\t      watch->menu.snapping = false;\n645\t      ai_menu_update_transform(watch);\n646\t    }\n647\t}\n648\t\n649\tstatic void ai_menu_start_snap(FAR struct ai_watch_s *watch, int index)\n650\t{\n651\t  FAR struct ai_menu_ctx_s *ctx = &watch->menu;\n652\t  float target_scroll_x;\n653\t  float target_scroll_y;\n654\t  lv_anim_t a;\n655\t\n656\t  if (index < 0 || index >= ctx->icon_count)\n657\t    {\n658\t      return;\n659\t    }\n660\t\n661\t  target_scroll_x = ctx->ico