***************************************\n42\t * Pre-processor Definitions\n43\t ****************************************************************************/\n44\t\n45\t#define AI_WATCH_VERSION            \"2.1.0\"\n46\t#define AI_WATCH_BUTTON_DEVICE      \"/dev/buttons\"\n47\t#define AI_WATCH_BUTTON_KEY2        (1 << 0)\n48\t#define AI_WATCH_BUTTON_POLL_MS     10\n49\t#define AI_WATCH_BUTTON_RELEASE_MS  80\n50\t#define AI_WATCH_RTC_MIN_YEAR       2020\n51\t#define AI_WATCH_INPUT_DEVICE       \"/dev/input0\"\n52\t\n53\t/* Page navigation */\n54\t\n55\t#define AI_WATCH_PAGE_HOME          0\n56\t#define AI_WATCH_PAGE_APP_LIST      1\n57\t#define AI_WATCH_PAGE_SETTINGS      2\n58\t#define AI_WATCH_PAGE_COUNT         3\n59\t\n60\t/* Swipe gesture thresholds */\n61\t\n62\t#define AI_WATCH_SWIPE_THRESHOLD    50\n63\t#define AI_WATCH_SWIPE_TIMEOUT_MS   300\n64\t\n65\t/* Theme definitions */\n66\t\n67\t#define AI_WATCH_THEME_DARK         0\n68\t#define AI_WATCH_THEME_LIGHT        1\n69\t#define AI_WATCH_THEME_BLUE         2\n70\t#define AI_WATCH_THEME_COUNT        3\n71\t\n72\t/****************************************************************************\n73\t * Private Types\n74\t ****************************************************************************/\n75\t\n76\tstruct ai_watch_s\n77\t{\n78\t  /* Display objects - Home page */\n79\t\n80\t  FAR lv_obj_t *home_screen;\n81\t  FAR lv_obj_t *time_label;\n82\t  FAR lv_obj_t *date_label;\n83\t  FAR lv_obj_t *bt_label;\n84\t\n85\t  /* Display objects - App list page */\n86\t\n87\t  FAR lv_obj_t *app_list_screen;\n88\t  FAR lv_obj_t *app_icons[4];\n89\t  FAR lv_obj_t *app_labels[4];\n90\t\n91\t  /* Display objects - Settings page */\n92\t\n93\t  FAR lv_obj_t *settings_screen;\n94\t  FAR lv_obj_t *bt_switch;\n95\t  FAR lv_obj_t *theme_roller;\n96\t  FAR lv_obj_t *about_label;\n97\t\n98\t  /* Page navigation */\n99\t\n100\t  int current_page;\n101\t  FAR lv_obj_t *pages[AI_WATCH_PAGE_COUNT];\n102\t\n103\t  /* Button state */\n104\t\n105\t  int button_fd;\n106\t  btn_buttonset_t supported_buttons;\n107\t  struct timespec button_raw_since;\n108\t  struct timespec next_button_poll;\n109\t  bool button_raw_pressed;\n110\t  bool button_armed;\n111\t\n112\t  /* Touch/swipe state */\n113\t\n114\t  bool touch_active;\n115\t  bool touch_available;\n116\t  int touch_start_x;\n117\t  int touch_start_y;\n118\t  struct timespec touch_start_time;\n119\t\n120\t  /* RTC state */\n121\t\n122\t  time_t displayed_second;\n123\t  bool rtc_valid;\n124\t  bool rtc_warning_printed;\n125\t\n126\t  /* Application state */\n127\t\n128\t  bool bt_state;\n129\t  bool settings_bt_enabled;\n130\t  int current_theme;\n131\t};\n132\t\n133\t/****************************************************************************\n134\t * Private Function Prototypes\n135\t ****************************************************************************/\n136\t\n137\tstatic void ai_watch_navigate_to(FAR struct ai_watch_s *watch, int page);\n138\tstatic void ai_watch_update_bt_state(FAR struct ai_watch_s *watch,\n139\t                                     bool new_state);\n140\tstatic void ai_watch_update_theme(FAR struct ai_watch_s *watch, int theme);\n141\tstatic void ai_watch_create_home_page(FAR struct ai_watch_s *watch);\n142\tstatic void ai_watch_create_app_list_page(FAR struct ai_watch_s *watch);\n143\tstatic void ai_watch_create_settings_page(FAR struct ai_watch_s *watch);\n144\t\n145\t/****************************************************************************\n146\t * Private Functions - Utilities\n147\t ****************************************************************************/\n148\t\n149\tstatic int64_t ai_watch_elapsed_ms(FAR const struct timespec *now,\n150\t                                   FAR const struct timespec *then)\n151\t{\n152\t  return (int64_t)(now->tv_sec - then->tv_sec) * 1000 +\n153\t         (now->tv_nsec - then->tv_nsec) / 1000000;\n154\t}\n155\t\n156\tstatic bool ai_watch_deadline_reached(FAR const struct timespec *now,\n157\t                                      FAR const struct timespec *deadline)\n158\t{\n159\t  return now->tv_sec > deadline->tv_sec ||\n160\t         (now->tv_sec == deadline->tv_sec &&\n161\t          now->tv_nsec >= deadline->tv_nsec);\n162\t}\n163\t\n164\tstatic void ai_watch_advance_deadline(FAR struct timespec *deadline,\n165\t                                      long delay_ms)\n166\t{\n167\t  deadline->tv_nsec += delay_ms * 1000000;\n168\t  deadline->tv_sec += deadline->tv_nsec / 1000000000;\n169\t  deadline->tv_nsec %= 1000000000;\n170\t}\n171\t\n172\t/****************************************************************************\n173\t * Private Functions - Theme Management\n174\t ****************************************************************************/\n175\t\n176\tstatic lv_color_t ai_watch_theme_bg(int theme)\n177\t{\n178\t  switch (theme)\n179\t    {\n180\t      case AI_WATCH_THEME_LIGHT:\n181\t        return lv_color_white();\n182\t      case AI_WATCH_THEME_BLUE:\n183\t        return lv_color_make(10, 25, 50);\n184\t      case AI_WATCH_THEME_DARK:\n185\t      default:\n186\t        return lv_color_black();\n187\t    }\n188\t}\n189\t\n190\tstatic lv_color_t ai_watch_theme_text(int theme)\n191\t{\n192\t  switch (theme)\n193\t    {\n194\t      case AI_WATCH_THEME_LIGHT:\n195\t        return lv_color_black();\n196\t      case AI_WATCH_THEME_BLUE:\n197\t        return lv_color_make(200, 220, 255);\n198\t      case AI_WATCH_THEME_DARK:\n199\t      default:\n200\t        return lv_color_white();\n201\t    }\n202\t}\n203\t\n204\tstatic lv_color_t ai_watch_theme_accent(int theme)\n205\t{\n206\t  switch (theme)\n207\t    {\n208\t      case AI_WATCH_THEME_LIGHT:\n209\t        return lv_color_make(0, 122, 255);\n210\t      case AI_WATCH_THEME_BLUE:\n211\t        return lv_color_make(100, 180, 255);\n212\t      case AI_WATCH_THEME_DARK:\n213\t      default:\n214\t        return lv_color_make(0, 191, 255);\n215\t    }\n216\t}\n217\t\n218\tstatic lv_color_t ai_watch_theme_secondary(int theme)\n219\t{\n220\t  switch (theme)\n221\t    {\n222\t      case AI_WATCH_THEME_LIGHT:\n223\t        return lv_color_make(100, 100, 100);\n224\t      case AI_WATCH_THEME_BLUE:\n225\t        return lv_color_make(120, 150, 200);\n226\t      case AI_WATCH_THEME_DARK:\n227\t      default:\n228\t        return lv_color_make(180, 180, 180);\n229\t    }\n230\t}\n231\t\n232\tstatic lv_color_t ai_watch_theme_btn_bg(int theme)\n233\t{\n234\t  switch (theme)\n235\t    {\n236\t      case AI_WATCH_THEME_LIGHT:\n237\t        return lv_color_make(230, 230, 230);\n238\t      case AI_WATCH_THEME_BLUE:\n239\t        return lv_color_make(20, 45, 80);\n240\t      case AI_WATCH_THEME_DARK:\n241\t      default:\n242\t        return lv_color_make(40, 40, 40);\n243\t    }\n244\t}\n245\t\n246\tstatic void ai_watch_update_theme(FAR struct ai_watch_s *watch, int theme)\n247\t{\n248\t  if (theme < 0 || theme >= AI_WATCH_THEME_COUNT ||\n249\t      theme == watch->current_theme)\n250\t    {\n251\t      return;\n252\t    }\n253\t\n254\t  watch->current_theme = theme;\n255\t  printf(\"Theme changed to %d\\n\", theme);\n256\t\n257\t  /* Update all pages with new theme colors */\n258\t\n259\t  lv_color_t bg = ai_watch_theme_bg(theme);\n260\t  lv_color_t text = ai_watch_theme_text(theme);\n261\t  lv_color_t accent = ai_watch_theme_accent(theme);\n262\t  lv_color_t secondary = ai_watch_theme_secondary(theme);\n263\t  lv_color_t btn_bg = ai_watch_theme_btn_bg(theme);\n264\t\n265\t  /* Home page - title, time, date, bt label, hint */\n266\t\n267\t  lv_obj_set_style_bg_color(watch->home_screen, bg, 0);\n268\t  lv_obj_set_style_text_color(\n269\t      lv_obj_get_child(watch->home_screen, 0), text, 0);\n270\t  lv_obj_set_style_text_color(watch->time_label, text, 0);\n271\t  lv_obj_set_style_text_color(watch->date_label, secondary, 0);\n272\t  lv_obj_set_style_text_color(watch->bt_label, accent, 0);\n273\t\n274\t  /* Find and update home page hint (last child) */\n275\t\n276\t  uint32_t home_child_count = lv_obj_get_child_count(watch->home_screen);\n277\t  if (home_child_count > 0)\n278\t    {\n279\t      lv_obj_set_style_text_color(\n280\t          lv_obj_get_child(watch->home_screen, home_child_count - 1),\n281\t          secondary, 0);\n282\t    }\n283\t\n284\t  /* App list page - title, grid, all buttons, hint */\n285\t\n286\t  lv_obj_set_style_bg_color(watch->app_list_screen, bg, 0);\n287\t  lv_obj_set_style_text_color(\n288\t      lv_obj_get_child(watch->app_list_screen, 0), text, 0);\n289\t\n290\t  /* Update grid and all app buttons */\n291\t\n292\t  uint32_t app_child_count =\n293\t      lv_obj_get_child_count(watch->app_list_screen);\n294\t  if (app_child_count > 1)\n295\t    {\n296\t      FAR lv_obj_t *grid =\n297\t          lv_obj_get_child(watch->app_list_screen, 1);\n298\t\n299\t      lv_obj_set_style_bg_color(grid, bg, 0);\n300\t      uint32_t grid_child_count = lv_obj_get_child_count(grid);\n301\t      uint32_t j;\n302\t\n303\t      for (j = 0; j < grid_child_count; j++)\n304\t        {\n305\t          FAR lv_obj_t *btn = lv_obj_get_child(grid, j);\n306\t\n307\t          lv_obj_set_style_bg_color(btn, btn_bg, 0);\n308\t\n309\t          /* Update icon and text labels inside button */\n310\t\n311\t          uint32_t btn_child_count = lv_obj_get_child_count(btn);\n312\t          uint32_t k;\n313\t\n314\t          for (k = 0; k < btn_child_count; k++)\n315\t            {\n316\t              lv_obj_set_style_text_color(\n317\t                  lv_obj_get_child(btn, k), text, 0);\n318\t            }\n319\t        }\n320\t    }\n321\t\n322\t  /* Find and update app list hint (last child) */\n323\t\n324\t  if (app_child_count > 0)\n325\t    {\n326\t      lv_obj_set_style_text_color(\n327\t          lv_obj_get_child(watch->app_list_screen, app_child_count - 1),\n328\t          secondary, 0);\n329\t    }\n330\t\n331\t  /* Settings page - title, labels, about, hint */\n332\t\n333\t  lv_obj_set_style_bg_color(watch->settings_screen, bg, 0);\n334\t\n335\t  uint32_t settings_child_count =\n336\t      lv_obj_get_child_count(watch->settings_screen);\n337\t  uint32_t i;\n338\t\n339\t  for (i = 0; i < settings_child_count; i++)\n340\t    {\n341\t      FAR lv_obj_t *child =\n342\t          lv_obj_get_child(watch->settings_screen, i);\n343\t\n344\t      /* Update all label colors */\n345\t\n346\t      if (child == watch->about_label)\n347\t        {\n348\t          lv_obj_set_style_text_color(child, secondary, 0);\n349\t        }\n350\t      else if (child != watch->bt_switch &&\n351\t               child != watch->theme_roller)\n352\t        {\n353\t          lv_obj_set_style_text_color(child, text, 0);\n354\t        }\n355\t    }\n356\t}\n357\t\n358\t/****************************************************************************\n359\t * Private Functions - State Management\n360\t ****************************************************************************/\n361\t\n362\tstatic void ai_watch_update_bt_state(FAR struct ai_watch_s *watch,\n363\t                                     bool new_state)\n364\t{\n365\t  watch->bt_state = new_state;\n366\t  watch->settings_bt_enabled = new_state;\n367\t\n368\t  /* Update home page BT label */\n369\t\n370\t  lv_label_set_text(watch->bt_label,\n371\t                    watch->bt_state ? \"BT: ON\" : \"BT: OFF\");\n372\t\n373\t  /* Update settings page switch if it exists */\n374\t\n375\t  if (watch->bt_switch != NULL)\n376\t    {\n377\t      if (watch->bt_state)\n378\t        {\n379\t          lv_obj_add_state(watch->bt_switch, LV_STATE_CHECKED);\n380\t        }\n381\t      else\n382\t        {\n383\t          lv_obj_clear_state(watch->bt_switch, LV_STATE_CHECKED);\n384\t        }\n385\t    }\n386\t\n387\t  printf(\"Bluetooth %s\\n\", watch->bt_state ? \"enabled\" : \"disabled\");\n388\t}\n389\t\n390\t/****************************************************************************\n391\t * Private Functions - Button Input\n392\t ****************************************************************************/\n393\t\n394\tstatic int ai_watch_button_initialize(FAR struct ai_watch_s *watch)\n395\t{\n396\t  btn_buttonset_t sample;\n397\t  ssize_t nread;\n398\t  int ret;\n399\t\n400\t  watch->button_fd = open(AI_WATCH_BUTTON_DEVICE, O_RDONLY | O_NONBLOCK);\n401\t  if (watch->button_fd < 0)\n402\t    {\n403\t      int errcode = errno;\n404\t\n405\t      printf(\"ERROR: Failed to open %s: %d\\n\",\n406\t             AI_WATCH_BUTTON_DEVICE, errcode);\n407\t      return -errcode;\n408\t    }\n409\t\n410\t  ret = ioctl(watch->button_fd, BTNIOC_SUPPORTED,\n411\t              (unsigned long)((uintptr_t)&watch->supported_buttons));\n412\t  if (ret < 0)\n413\t    {\n414\t      int errcode = errno;\n415\t\n416\t      printf(\"ERROR: BTNIOC_SUPPORTED failed: %d\\n\", errcode);\n417\t      close(watch->button_fd);\n418\t      watch->button_fd = -1;\n419\t      return -errcode;\n420\t    }\n421\t\n422\t  nread = read(watch->button_fd, &sample, sizeof(sample));\n423\t  if (nread != sizeof(sample))\n424\t    {\n425\t      int errcode = nread < 0 ? errno : EIO;\n426\t\n427\t      printf(\"ERROR: Initial button read failed: %d\\n\", errcode);\n428\t      close(watch->button_fd);\n429\t      watch->button_fd = -1;\n430\t      return -errcode;\n431\t    }\n432\t\n433\t  clock_gettime(CLOCK_MONOTONIC, &watch->next_button_poll);\n434\t  watch->button_raw_since = watch->next_button_poll;\n435\t  watch->button_raw_pressed = (sample & AI_WATCH_BUTTON_KEY2) != 0;\n436\t  watch->button_armed = !watch->button_raw_pressed;\n437\t\n438\t  printf(\"Supported buttons: 0x%02lx\\n\",\n439\t         (unsigned long)watch->supported_buttons);\n440\t  printf(\"KEY2 button monitor started\\n\");\n441\t  return OK;\n442\t}\n443\t\n444\tstatic void ai_watch_button_update(FAR struct ai_watch_s *watch,\n445\t                                   FAR const struct timespec *now)\n446\t{\n447\t  btn_buttonset_t sample;\n448\t  bool pressed;\n449\t  ssize_t nread;\n450\t\n451\t  if (watch->button_fd < 0 ||\n452\t      !ai_watch_deadline_reached(now, &watch->next_button_poll))\n453\t    {\n454\t      return;\n455\t    }\n456\t\n457\t  watch->next_button_poll = *now;\n458\t  ai_watch_advance_deadline(&watch->next_button_poll,\n459\t                            AI_WATCH_BUTTON_POLL_MS);\n460\t\n461\t  nread = read(watch->button_fd, &sample, sizeof(sample));\n462\t  if (nread != sizeof(sample))\n463\t    {\n464\t      if (nread < 0 && errno != EAGAIN && errno != EINTR)\n465\t        {\n466\t          printf(\"ERROR: Button read failed: %d\\n\", errno);\n467\t        }\n468\t\n469\t      return;\n470\t    }\n471\t\n472\t  pressed = (sample & AI_WATCH_BUTTON_KEY2) != 0;\n473\t  if (pressed != watch->button_raw_pressed)\n474\t    {\n475\t      watch->button_raw_pressed = pressed;\n476\t      watch->button_raw_since = *now;\n477\t    }\n478\t\n479\t  if (pressed)\n480\t    {\n481\t      if (watch->button_armed)\n482\t        {\n483\t          watch->button_armed = false;\n484\t\n485\t          /* KEY2 acts as back button */\n486\t\n487\t          if (watch->current_page == AI_WATCH_PAGE_HOME)\n488\t            {\n489\t              /* On home page, toggle BT */\n490\t\n491\t              ai_watch_update_bt_state(watch, !watch->bt_state);\n492\t              printf(\"KEY2 pressed: BT %s\\n\",\n493\t                     watch->bt_state ? \"ON\" : \"OFF\");\n494\t            }\n495\t          else\n496\t            {\n497\t              /* On other pages, go back to home */\n498\t\n499\t              ai_watch_navigate_to(watch, AI_WATCH_PAGE_HOME);\n500\t              printf(\"KEY2 pressed: Back to home\\n\");\n501\t            }\n502\t        }\n503\t    }\n504\t  else if (ai_watch_elapsed_ms(now, &watch->button_raw_since) >=\n505\t           AI_WATCH_BUTTON_RELEASE_MS)\n506\t    {\n507\t      watch->button_armed = true;\n508\t    }\n509\t}\n510\t\n511\t/****************************************************************************\n512\t * Private Functions - Time Update\n513\t ****************************************************************************/\n514\t\n515\tstatic void ai_watch_time_update(FAR struct ai_watch_s *watch)\n516\t{\n517\t  char date[32];\n518\t  char time[16];\n519\t  char about[128];\n520\t  struct timespec ts;\n521\t  struct tm tm;\n522\t\n523\t  if (clock_gettime(CLOCK_REALTIME, &ts) < 0 ||\n524\t      localtime_r(&ts.tv_sec, &tm) == NULL ||\n525\t      tm.tm_year + 1900 < AI_WATCH_RTC_MIN_YEAR)\n526\t    {\n527\t      if (!watch->rtc_warning_printed)\n528\t        {\n529\t          printf(\"RTC time is not set; waiting for time synchronization\\n\");\n530\t          watch->rtc_warning_printed = true;\n531\t        }\n532\t\n533\t      if (watch->rtc_valid)\n534\t        {\n535\t          lv_label_set_text(watch->time_label, \"--:--:--\");\n536\t          lv_label_set_text(watch->date_label, \"Date not set\");\n537\t          watch->rtc_valid = false;\n538\t\n539\t          /* Update about label with correct RTC status */\n540\t\n541\t          snprintf(about, sizeof(about),\n542\t                   \"AI Watch v\" AI_WATCH_VERSION \"\\n\"\n543\t                   \"Board: SF32LB52\\n\"\n544\t                   \"Touch: %s\\n\"\n545\t                   \"RTC: Not set\",\n546\t                   watch->touch_available ? \"Active\" : \"Unavailable\");\n547\t          lv_label_set_text(watch->about_label, about);\n548\t        }\n549\t\n550\t      return;\n551\t    }\n552\t\n553\t  watch->rtc_valid = true;\n554\t  if (ts.tv_sec == watch->displayed_second)\n555\t    {\n556\t      return;\n557\t    }\n558\t\n559\t  watch->displayed_second = ts.tv_sec;\n560\t  strftime(time, sizeof(time), \"%H:%M:%S\", &tm);\n561\t  strftime(date, sizeof(date), \"%Y-%m-%d\", &tm);\n562\t  lv_label_set_text(watch->time_label, time);\n563\t  lv_label_set_text(watch->date_label, date);\n564\t\n565\t  /* Update about label with current time */\n566\t\n567\t  snprintf(about, sizeof(about),\n568\t           \"AI Watch v\" AI_WATCH_VERSION \"\\n\"\n569\t           \"Board: SF32LB52\\n\"\n570\t           \"Touch: %s\\n\"\n571\t           \"RTC: %s\",\n572\t           watch->touch_available ? \"Active\" : \"Unavailable\",\n573\t           time);\n574\t  lv_label_set_text(watch->about_label, about);\n575\t}\n576\t\n577\t/****************************************************************************\n578\t * Private Functions - Page Navigation\n579\t ****************************************************************************/\n580\t\n581\tstatic void ai_watch_navigate_to(FAR struct ai_watch_s *watch, int page)\n582\t{\n583\t  if (page < 0 || page >= AI_WATCH_PAGE_COUNT ||\n584\t      page == watch->current_page)\n585\t    {\n586\t      return;\n587\t    }\n588\t\n589\t  /* Switch to target screen */\n590\t\n591\t  watch->current_page = page;\n592\t  if (watch->pages[page] != NULL)\n593\t    {\n594\t      lv_scr_load_anim(watch->pages[page], LV_SCR_LOAD_ANIM_NONE, 0, 0,\n595\t                       false);\n596\t      printf(\"Navigated to page %d\\n\", page);\n597\t    }\n598\t}\n599\t\n600\t/****************************************************************************\n601\t * Private Functions - UI Callbacks\n602\t ****************************************************************************/\n603\t\n604\tstatic void ai_watch_app_icon_cb(lv_event_t *e)\n605\t{\n606\t  FAR lv_obj_t *btn = lv_event_get_target(e);\n607\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n608\t  int index = (int)(intptr_t)lv_obj_get_user_data(btn);\n609\t\n610\t  printf(\"App %d tapped\\n\", index);\n611\t\n612\t  switch (index)\n613\t    {\n614\t      case 0: /* Exercise */\n615\t      case 1: /* Timer */\n616\t      case 2: /* Reminder */\n617\t        {\n618\t          FAR lv_obj_t *msgbox = lv_msgbox_create(NULL);\n619\t\n620\t          lv_msgbox_add_title(msgbox, \"Coming Soon\");\n621\t          lv_msgbox_add_text(msgbox, \"This app is under development.\");\n622\t          lv_msgbox_add_close_button(msgbox);\n623\t          break;\n624\t        }\n625\t      case 3: /* Settings */\n626\t        {\n627\t          ai_watch_navigate_to(watch, AI_WATCH_PAGE_SETTINGS);\n628\t          break;\n629\t        }\n630\t      default:\n631\t        break;\n632\t    }\n633\t}\n634\t\n635\tstatic void ai_watch_settings_bt_cb(lv_event_t *e)\n636\t{\n637\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n638\t  FAR lv_obj_t *sw = lv_event_get_target(e);\n639\t  bool new_state = lv_obj_has_state(sw, LV_STATE_CHECKED);\n640\t\n641\t  ai_watch_update_bt_state(watch, new_state);\n642\t}\n643\t\n644\tstatic void ai_watch_settings_theme_cb(lv_event_t *e)\n645\t{\n646\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n647\t  FAR lv_obj_t *roller = lv_event_get_target(e);\n648\t  int theme = lv_roller_get_selected(roller);\n649\t\n650\t  ai_watch_update_theme(watch, theme);\n651\t}\n652\t\n653\tstatic void ai_watch_back_cb(lv_event_t *e)\n654\t{\n655\t  FAR struct ai_watch_s *watch = lv_event_get_user_data(e);\n656\t\n657\t  if (watch->current_page == AI_WATCH_PAGE_SETTINGS ||\n658\t      watch->current_page == AI_WATCH_PAGE_APP_LIST)\n659\t    {\n660\t      ai_watch_navigate_to(watch, AI_WATCH_PAGE_HOME);\n661\t    }\n662\t}\n663\t\n664\t/****************************************************************************\n665\t * Private Functions - UI Creation\n666\t ****************************************************************************/\n667\t\n668\tstatic void ai_watch_create_home_page(FAR struct ai_watch_s *watch)\n669\t{\n670\t  FAR lv_obj_t *screen = lv_obj_create(NULL);\n671\t  FAR lv_obj_t *title;\n672\t  FAR lv_obj_t *hint;\n673\t\n674\t  lv_obj_set_style_bg_color(screen, ai_watch_theme_bg(watch->current_theme),\n675\t                            0);\n676\t  watch->home_screen = screen;\n677\t  watch->pages[AI_WATCH_PAGE_HOME] = screen;\n678\t\n679\t  /* Title */\n680\t\n681\t  title = lv_label_create(screen);\n682\t  lv_label_set_text(title, \"AI Watch\");\n683\t  lv_obj_set_style_text_color(title,\n684\t                              ai_watch_theme_text(watch->current_theme), 0);\n685\t  lv_obj_set_style_text_font(title, &lv_font_montserrat_28, 0);\n686\t  lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 55);\n687\t\n688\t  /* Time display */\n689\t\n690\t  watch->time_label = lv_label_create(screen);\n691\t  lv_label_set_text(watch->time_label, \"--:--:--\");\n692\t  lv_obj_set_style_text_color(watch->time_label,\n693\t                              ai_watch_theme_text(watch->current_theme), 0);\n694\t  lv_obj_set_style_text_font(watch->time_label, &lv_font_montserrat_24, 0);\n695\t  lv_obj_align(watch->time_label, LV_ALIGN_CENTER, 0, -10);\n696\t\n697\t  /* Date display */\n698\t\n699\t  watch->date_label = lv_label_create(screen);\n700\t  lv_label_set_text(watch->date_label, \"Date not set\");\n701\t  lv_obj_set_style_text_color(watch->date_label,\n702\t                              ai_watch_theme_secondary(watch->current_theme),\n703\t                              0);\n704\t  lv_obj_set_style_text_font(watch->date_label, &lv_font_montserrat_16, 0);\n705\t  lv_obj_align_to(watch->date_label, watch->time_label,\n706\t                  LV_ALIGN_OUT_BOTTOM_MID, 0, 12);\n707\t\n708\t  /* Bluetooth status */\n709\t\n710\t  watch->bt_label = lv_label_create(screen);\n711\t  lv_label_set_text(watch->bt_label, \"BT: OFF\");\n712\t  lv_obj_set_style_text_color(\n713\t      watch->bt_label,\n714\t      ai_watch_theme_accent(watch->current_theme), 0);\n715\t  lv_obj_set_style_text_font(watch->bt_label, &lv_font_montserrat_20, 0);\n716\t  lv_obj_align(watch->bt_label, LV_ALIGN_BOTTOM_MID, 0, -55);\n717\t\n718\t  /* Navigation hint */\n719\t\n720\t  hint = lv_label_create(screen);\n721\t  lv_label_set_text(hint, \"Tap or swipe up for apps\");\n722\t  lv_obj_set_style_text_color(hint,\n723\t                              ai_watch_theme_secondary(watch->current_theme),\n724\t                              0);\n725\t  lv_o