5\t    static lv_indev_state_t last_event = LV_INDEV_STATE_REL;\n66\t\n67\t    if (last_event != event) //Not execute repeatly.\n68\t    {\n69\t        last_event = event;\n70\t\n71\t        if ((LV_INDEV_STATE_PR == event) && (LV_KEY_HOME == key))\n72\t        {\n73\t            LOG_I(\"default_keypad_handler %d,%d\", key, event);\n74\t            if (gui_app_is_actived(\"Main\"))\n75\t                gui_app_run(\"clock\");\n76\t            else\n77\t            {\n78\t                gui_app_run(\"Main\");\n79\t#if defined(GUI_APP_FRAMEWORK)&&(!defined (APP_TRANS_ANIMATION_NONE))\n80\t                lvsf_gesture_bars_realign();\n81\t#endif\n82\t            }\n83\t        }\n84\t        else if ((LV_INDEV_STATE_PR == event) && (LV_KEY_ESC == key))\n85\t        {\n86\t            gui_app_goback();\n87\t        }\n88\t    }\n89\t\n90\t    return LV_BLOCK_EVENT;\n91\t}\n92\t\n93\t\n94\t#ifdef USING_BUTTON_LIB\n95\t\n96\t#include \"button.h\"\n97\t\n98\t#ifdef BSP_KEY1_ACTIVE_HIGH\n99\t    #define BUTTON_ACTIVE_POL BUTTON_ACTIVE_HIGH\n100\t#else\n101\t    #define BUTTON_ACTIVE_POL BUTTON_ACTIVE_LOW\n102\t#endif\n103\t\n104\t\n105\ttypedef enum\n106\t{\n107\t    KEYPAD_KEY_HOME = 2,\n108\t} keypad_key_code_t;\n109\t\n110\ttypedef enum\n111\t{\n112\t    KEYPAD_KEY_STATE_REL,\n113\t    KEYPAD_KEY_STATE_PRESSED,\n114\t} keypad_key_state_t;\n115\t\n116\ttypedef struct\n117\t{\n118\t    keypad_key_code_t last_key;\n119\t    keypad_key_state_t last_key_state;\n120\t} keypad_status_t;\n121\t\n122\tstatic int32_t key1_button_handle = -1;\n123\tstatic keypad_status_t keypad_status;\n124\t\n125\tvoid button_key_read(uint32_t *last_key, lv_indev_state_t *state)\n126\t{\n127\t    if (last_key && state)\n128\t    {\n129\t        *last_key = keypad_status.last_key;\n130\t        if (KEYPAD_KEY_STATE_REL == keypad_status.last_key_state)\n131\t        {\n132\t            *state = LV_INDEV_STATE_REL;\n133\t        }\n134\t        else\n135\t        {\n136\t            *state = LV_INDEV_STATE_PR;\n137\t            keypad_status.last_key_state = KEYPAD_KEY_STATE_REL;\n138\t        }\n139\t    }\n140\t}\n141\t\n142\t/* button event handler in UI inactive state */\n143\tstatic void button_event_handler(int32_t pin, button_action_t action)\n144\t{\n145\t#ifdef BSP_USING_PM\n146\t    gui_pm_action_t pm_action;\n147\t\n148\t    LOG_I(\"button:%d,%d\", pin, action);\n149\t\n150\t    if ((SLEEP_CTRL_PIN == pin) && (!gui_is_active() || (action == BUTTON_LONG_PRESSED)))\n151\t    {\n152\t        pm_action = GUI_PM_ACTION_INVALID;\n153\t        switch (action)\n154\t        {\n155\t        case BUTTON_PRESSED:\n156\t        {\n157\t            pm_action = GUI_PM_ACTION_BUTTON_PRESSED;\n158\t            break;\n159\t        }\n160\t        case BUTTON_RELEASED:\n161\t        {\n162\t            pm_action = GUI_PM_ACTION_BUTTON_RELEASED;\n163\t            break;\n164\t        }\n165\t        case BUTTON_CLICKED:\n166\t        {\n167\t            pm_action = GUI_PM_ACTION_BUTTON_CLICKED;\n168\t            break;\n169\t        }\n170\t        case BUTTON_LONG_PRESSED:\n171\t        {\n172\t            pm_action = GUI_PM_ACTION_BUTTON_LONG_PRESSED;\n173\t            break;\n174\t        }\n175\t        default:\n176\t        {\n177\t            pm_action = GUI_PM_ACTION_INVALID;\n178\t        }\n179\t        }\n180\t        if (GUI_PM_ACTION_INVALID != pm_action)\n181\t        {\n182\t            gui_pm_fsm(pm_action);\n183\t        }\n184\t    }\n185\t    else\n186\t#endif  /* BSP_USING_PM */\n187\t    {\n188\t        lv_disp_trig_activity(NULL);\n189\t        switch (action)\n190\t        {\n191\t        case BUTTON_CLICKED:\n192\t        {\n193\t            keypad_status.last_key = KEYPAD_KEY_HOME;\n194\t            keypad_status.last_key_state = KEYPAD_KEY_STATE_PRESSED;\n195\t            break;\n196\t        }\n197\t        default:\n198\t            break;\n199\t        }\n200\t    }\n201\t}\n202\t\n203\tstatic void init_pin(void)\n204\t{\n205\t    button_